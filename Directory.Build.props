<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <Authors>sockless-coding</Authors>
    <Product>Sockless Port</Product>
    <!-- Releases set it from the tag (yyyy.mm.rev, see docs/releasing.md); other builds identify as dev builds. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>

{
  "name": "sockless-port-codemirror",
  "private": true,
  "description": "Builds src/Sockless.Port.Web/wwwroot/lib/codemirror/codemirror.js. Not part of the app build; run it when bumping a version.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --legal-comments=none --target=es2020 --outfile=../../src/Sockless.Port.Web/wwwroot/lib/codemirror/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2"
  }
}

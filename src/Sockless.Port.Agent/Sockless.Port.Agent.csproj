<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The remote agent: relays the Engine API from the local socket to Sockless Port over mutual
    TLS, and enrols itself with the server's internal CA. Native AOT, so the image stays small.
  -->
  <PropertyGroup>
    <RootNamespace>Sockless.Port.Agent</RootNamespace>
    <AssemblyName>sockless-port-agent</AssemblyName>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sockless.Port.Docker\Sockless.Port.Docker.csproj" />
    <InternalsVisibleTo Include="Sockless.Port.Agent.Tests" />
  </ItemGroup>
</Project>

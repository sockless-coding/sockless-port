@page "/account/external/{handler?}"
@model Sockless.Port.Web.Pages.Account.ExternalModel
@{
    ViewData["Title"] = "Single sign-on";
    Layout = "_AuthLayout";
}
@section Head {
    @if (Model.ContinueTo is not null)
    {
        <meta http-equiv="refresh" content="0;url=@Model.ContinueTo" />
    }
}

<section class="card card-plate" aria-labelledby="sso-title">
    <h1 id="sso-title" class="mb-4 font-heading text-lg uppercase tracking-[0.08em]">Single sign-on</h1>
    @if (Model.Refusal is not null)
    {
        <div class="callout danger mb-4" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Refusal</p>
        </div>
        <a asp-page="/Account/Login" class="btn-soft">Back to sign in</a>
    }
    else if (Model.ContinueTo is not null)
    {
        <p class="mb-4">You're signed in.</p>
        <a href="@Model.ContinueTo" class="btn-primary w-full">Continue</a>
    }
</section>

@page "/endpoints"
@model Sockless.Port.Web.Pages.Endpoints.IndexModel
@{
    ViewData["Title"] = "Endpoints";
    // A list: tables use the width there is.
    ViewData["Wide"] = true;
}

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="page-title">Endpoints</h2>
        <p class="mt-1 text-secondary">The engines Sockless Port manages: the local one, and remote hosts through the agent.</p>
    </div>
    <a asp-page="/Endpoints/Add" class="btn-primary" sp-can="admin"><icon name="plus" class="h-4 w-4" /> Add agent</a>
</div>

@if (Model.Connections.Count == 0)
{
    <section class="card">
        <div class="empty-state">
            <icon name="server-stack" class="h-12 w-12" stroke-width="1.5" />
            <p class="text-base text-heading">No endpoints for you yet</p>
            <p class="text-secondary">An administrator gives you a role on the endpoints you need.</p>
        </div>
    </section>
}
else
{
    <partial name="_EndpointTable" model="Model.Connections" />
}

@page "/endpoints"
@model Sockless.Port.Web.Pages.Endpoints.IndexModel
@{
    ViewData["Title"] = "Endpoints";
}

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="page-title">Endpoints</h2>
        <p class="mt-1 text-secondary">The engines Sockless Port manages: the local one, and remote hosts through the agent.</p>
    </div>
    <a asp-page="/Endpoints/Add" class="btn-primary"><icon name="plus" class="h-4 w-4" /> Add agent</a>
</div>

<partial name="_EndpointTable" model="Model.Connections" />

@model IReadOnlyList<Sockless.Port.Engines.EngineConnection>
@using Sockless.Port.Agents
@using Sockless.Port.Engines
<div id="endpoint-table" class="table-wrap"
     hx-get="@Url.Page("/Endpoints/Index", "Table")" hx-trigger="endpoints-changed from:body" hx-swap="outerHTML">
    <table class="table">
        <caption class="sr-only">Endpoints</caption>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Address</th>
                <th scope="col">Engine</th>
                <th scope="col">Status</th>
                <th scope="col">Since</th>
                <th scope="col" class="num"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var endpoint in Model)
            {
                var agentVersion = endpoint.Agent?.Info?.Version;
                <tr>
                    <th scope="row">
                        <a asp-page="/Engine/Index" asp-route-endpointId="@endpoint.Id" class="font-semibold hover:underline">@endpoint.Name</a>
                        <span class="mt-1 flex flex-wrap gap-1">
                            @if (endpoint.IsLocal)
                            {
                                <span class="badge-stat">Local</span>
                            }
                            else
                            {
                                <span class="badge-stat">Agent@(agentVersion is null ? "" : $" {agentVersion}")</span>
                                @if (endpoint.IsEdge)
                                {
                                    <span class="badge-stat">Edge</span>
                                }
                                @if (AgentCommands.IsOutdated(agentVersion))
                                {
                                    <span class="badge warning">Update available</span>
                                }
                            }
                        </span>
                    </th>
                    <td class="break-all text-xs">
                        @if (endpoint.Edge is { } edge)
                        {
                            <span class="block">Dials <span class="font-mono">@edge.ServerUrl</span></span>
                            <span class="mt-1 block text-secondary">
                                @(edge.ConnectedSince is not null ? "Tunnel up" : edge.SeenAt is { } seen ? $"Tunnel down, last up {Format.Timestamp(seen)}" : "Tunnel never connected")
                            </span>
                        }
                        else
                        {
                            <span class="font-mono">@endpoint.Address</span>
                        }
                    </td>
                    <td>
                        @if (endpoint.Engine is { } engine)
                        {
                            <partial name="_EngineBadges" model="engine" />
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td>
                        <partial name="_EndpointStateBadge" model="endpoint.State" />
                        @switch (endpoint.State)
                        {
                            case EndpointOffline offline:
                                <p class="mt-1 max-w-xs text-xs text-secondary">@offline.Reason</p>
                                break;
                            case EndpointEnrolling { Problem: { } problem }:
                                <p class="mt-1 max-w-xs text-xs text-secondary">@problem</p>
                                break;
                        }
                    </td>
                    <td class="whitespace-nowrap font-mono text-xs text-secondary">@Format.Timestamp(endpoint.State.Since)</td>
                    <td class="num">
                        <a asp-page="/Endpoints/Settings" asp-route-endpointId="@endpoint.Id" class="btn-soft" aria-label="Settings for @endpoint.Name" sp-can="admin">
                            <icon name="cog-6-tooth" class="h-4 w-4" /> Settings
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model Sockless.Port.Web.Pages.Engine.Containers.IndexModel
@{
    var filters = Model.Filters;
    var refreshUrl = Url.Page("/Engine/Containers/Index", "Table", filters);
}
@* Live: refreshes on engine events, but not while rows are selected (data-pause-when-selected). *@
<div id="container-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="cube" class="h-12 w-12" stroke-width="1.5" />
                @if (Model.Filtered && Model.Total > 0)
                {
                    <p class="text-base text-heading">No containers match these filters</p>
                    <p class="text-secondary"><a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
                }
                else
                {
                    <p class="text-base text-heading">No containers yet</p>
                    <p class="text-secondary">Create one to get started.</p>
                }
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="row-actions" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="bulk-form" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk"
              asp-route-endpointId="@Model.EndpointId" asp-route-state="@Model.State" asp-route-q="@Model.Q"
              asp-route-stack="@Model.Stack" asp-route-pod="@Model.Pod" asp-route-label="@Model.Label">
            <div class="mb-3 flex flex-wrap items-center gap-2" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown</span>
                <span class="flex-1"></span>
                <button sp-can="write" type="submit" name="action" value="start" class="btn-soft" data-bulk-action disabled>
                    <icon name="play" class="h-4 w-4" /> Start
                </button>
                <button sp-can="write" type="submit" name="action" value="stop" class="btn-soft" data-bulk-action disabled>
                    <icon name="stop" class="h-4 w-4" /> Stop
                </button>
                <button sp-can="write" type="submit" name="action" value="restart" class="btn-soft" data-bulk-action disabled>
                    <icon name="arrow-path" class="h-4 w-4" /> Restart
                </button>
                <button sp-can="write" type="submit" name="action" value="remove" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Running containers are stopped first. Named volumes are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <partial name="_ContainerGrid" model="Model.Table" />
        </form>
    }
</div>

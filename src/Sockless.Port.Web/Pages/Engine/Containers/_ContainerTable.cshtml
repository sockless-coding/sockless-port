@model Sockless.Port.Web.Pages.Engine.Containers.IndexModel
@{
    var filters = new { endpointId = Model.EndpointId, Model.State, Model.Q, Model.Stack, Model.Label };
    var refreshUrl = Url.Page("/Engine/Containers/Index", "Table", filters);
}
@* Live: refreshes on engine events, but not while rows are selected (data-pause-when-selected). *@
<div id="container-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="cube" class="h-12 w-12" stroke-width="1.5" />
                @if (Model.Filtered && Model.Total > 0)
                {
                    <p class="text-base text-heading">No containers match these filters</p>
                    <p class="text-secondary"><a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
                }
                else
                {
                    <p class="text-base text-heading">No containers yet</p>
                    <p class="text-secondary">Create one to get started.</p>
                }
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="row-actions" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="bulk-form" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk"
              asp-route-endpointId="@Model.EndpointId" asp-route-state="@Model.State" asp-route-q="@Model.Q"
              asp-route-stack="@Model.Stack" asp-route-label="@Model.Label">
            <div class="mb-3 flex flex-wrap items-center gap-2" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown</span>
                <span class="flex-1"></span>
                <button type="submit" name="action" value="start" class="btn-soft" data-bulk-action disabled>
                    <icon name="play" class="h-4 w-4" /> Start
                </button>
                <button type="submit" name="action" value="stop" class="btn-soft" data-bulk-action disabled>
                    <icon name="stop" class="h-4 w-4" /> Stop
                </button>
                <button type="submit" name="action" value="restart" class="btn-soft" data-bulk-action disabled>
                    <icon name="arrow-path" class="h-4 w-4" /> Restart
                </button>
                <button type="submit" name="action" value="remove" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Running containers are stopped first. Named volumes are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <caption class="sr-only">Containers</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="w-8"><input type="checkbox" data-select-all aria-label="Select all shown containers" /></th>
                            <th scope="col">Name</th>
                            <th scope="col">State</th>
                            <th scope="col">Image</th>
                            <th scope="col">Ports</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="num"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var created = Format.FromUnix(row.Summary.Created);
                            <tr>
                                <td><input type="checkbox" name="ids" value="@row.Summary.Id" data-name="@row.Name" aria-label="Select @row.Name" /></td>
                                <th scope="row">
                                    <a asp-page="/Engine/Containers/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@row.Summary.Id"
                                       class="font-semibold hover:underline">@row.Name</a>
                                    <span class="mt-1 flex flex-wrap gap-1">
                                        @if (row.Stack is not null)
                                        {
                                            <span class="badge-stat" title="Stack">@row.Stack</span>
                                        }
                                        @if (row.SwarmService is not null)
                                        {
                                            <span class="badge-stat" title="Managed by this swarm service">Swarm: @row.SwarmService</span>
                                        }
                                        @if (Sockless.Port.Containers.ContainerLabels.IsHelper(row.Summary.Labels))
                                        {
                                            <span class="badge-stat" title="Started by Sockless Port to read a volume's files. It's removed when the file browser closes.">File browser helper</span>
                                        }
                                    </span>
                                </th>
                                <td>
                                    <span class="flex flex-wrap gap-1">
                                        <partial name="_StatusBadge" model="row.State" />
                                        @if (row.Health is not null)
                                        {
                                            <partial name="_StatusBadge" model="row.Health" />
                                        }
                                    </span>
                                    <span class="mt-1 block text-xs text-secondary">@row.Summary.Status</span>
                                </td>
                                <td class="max-w-[16rem] break-all font-mono text-xs">@row.Summary.Image</td>
                                <td class="font-mono text-xs">
                                    @foreach (var port in row.Ports)
                                    {
                                        <span class="block whitespace-nowrap">@port</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap text-secondary" title="@Format.Timestamp(created)">@Format.Relative(created)</td>
                                <td class="num">
                                    @if (row.Running)
                                    {
                                        <button type="submit" form="row-actions" class="btn-soft" aria-label="Stop @row.Name"
                                                formaction="@Url.Page("/Engine/Containers/Index", "Bulk", new { endpointId = Model.EndpointId, Model.State, Model.Q, Model.Stack, Model.Label, ids = row.Summary.Id, action = "stop" })">
                                            <icon name="stop" class="h-4 w-4" /> Stop
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" form="row-actions" class="btn-soft" aria-label="Start @row.Name"
                                                formaction="@Url.Page("/Engine/Containers/Index", "Bulk", new { endpointId = Model.EndpointId, Model.State, Model.Q, Model.Stack, Model.Label, ids = row.Summary.Id, action = "start" })">
                                            <icon name="play" class="h-4 w-4" /> Start
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</div>

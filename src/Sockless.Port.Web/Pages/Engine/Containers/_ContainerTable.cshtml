@model Sockless.Port.Web.Pages.Engine.Containers.IndexModel
@{
    var filters = Model.Filters;
    var refreshUrl = Url.Page("/Engine/Containers/Index", "Table", filters);
    string RowAction(string id, string action) =>
        Url.Page("/Engine/Containers/Index", "Bulk", new { endpointId = Model.EndpointId, Model.State, Model.Q, Model.Stack, Model.Pod, Model.Label, ids = id, action })!;
}
@* Live: refreshes on engine events, but not while rows are selected (data-pause-when-selected). *@
<div id="container-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="cube" class="h-12 w-12" stroke-width="1.5" />
                @if (Model.Filtered && Model.Total > 0)
                {
                    <p class="text-base text-heading">No containers match these filters</p>
                    <p class="text-secondary"><a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
                }
                else
                {
                    <p class="text-base text-heading">No containers yet</p>
                    <p class="text-secondary">Create one to get started.</p>
                }
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="row-actions" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="bulk-form" method="post" asp-page="/Engine/Containers/Index" asp-page-handler="Bulk"
              asp-route-endpointId="@Model.EndpointId" asp-route-state="@Model.State" asp-route-q="@Model.Q"
              asp-route-stack="@Model.Stack" asp-route-pod="@Model.Pod" asp-route-label="@Model.Label">
            <div class="mb-3 flex flex-wrap items-center gap-2" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown</span>
                <span class="flex-1"></span>
                <button sp-can="write" type="submit" name="action" value="start" class="btn-soft" data-bulk-action disabled>
                    <icon name="play" class="h-4 w-4" /> Start
                </button>
                <button sp-can="write" type="submit" name="action" value="stop" class="btn-soft" data-bulk-action disabled>
                    <icon name="stop" class="h-4 w-4" /> Stop
                </button>
                <button sp-can="write" type="submit" name="action" value="restart" class="btn-soft" data-bulk-action disabled>
                    <icon name="arrow-path" class="h-4 w-4" /> Restart
                </button>
                <button sp-can="write" type="submit" name="action" value="remove" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Running containers are stopped first. Named volumes are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <div class="table-wrap">
                <table class="table table-middle">
                    <caption class="sr-only">Containers@(Model.ShowGroups ? ", grouped by stack" : "")</caption>
                    <thead>
                        <tr>
                            <th sp-can="write" scope="col" class="w-8"><input type="checkbox" data-select-all aria-label="Select all shown containers" /></th>
                            <th scope="col">Name</th>
                            <th scope="col">State</th>
                            <th scope="col">Image</th>
                            <th scope="col">Ports</th>
                            <th scope="col" class="num"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    @foreach (var group in Model.Groups)
                    {
                        <tbody>
                            @if (Model.ShowGroups)
                            {
                                <tr class="table-group">
                                    <td sp-can="write">
                                        <input type="checkbox" data-select-group="@group.Key"
                                               aria-label="@(group.Stack is null ? "Select the containers not in a stack" : $"Select the containers of {group.Stack}")" />
                                    </td>
                                    <th scope="rowgroup" colspan="5">
                                        <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                            @if (group.Stack is { } stack)
                                            {
                                                <span class="flex items-center gap-2">
                                                    <icon name="rectangle-stack" class="h-4 w-4 text-secondary" />
                                                    <a asp-page="/Engine/Stacks/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-stackName="@stack"
                                                       class="font-mono font-semibold hover:underline" title="Open the stack">@stack</a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="flex items-center gap-2 text-secondary">
                                                    <icon name="cube" class="h-4 w-4" /> Not in a stack
                                                </span>
                                            }
                                            <span class="text-xs font-normal text-secondary">@group.Running of @group.Rows.Count running</span>
                                        </span>
                                    </th>
                                </tr>
                            }
                            @foreach (var row in group.Rows)
                            {
                                var created = Format.FromUnix(row.Summary.Created);
                                var since = ContainerStatus.Since(row.Summary.Status);
                                var (prefix, image) = ImageDisplay.SplitReference(row.Summary.Image);
                                var update = ImageDisplay.UpdateBadge(row.Update) is { Kind: "warning" } updateBadge ? updateBadge : null;
                                var (scanBadge, scanDetail) = row.Scan?.Display() ?? (null, null);
                                <tr>
                                    <td sp-can="write"><input type="checkbox" name="ids" value="@row.Summary.Id" data-name="@row.Name" data-group="@group.Key" aria-label="Select @row.Name" /></td>
                                    <th scope="row">
                                        <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            <a asp-page="/Engine/Containers/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@row.Summary.Id"
                                               class="break-words font-semibold hover:underline">@row.Name</a>
                                            @if (row.Pod is { } member)
                                            {
                                                <a asp-page="/Engine/Pods/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-podId="@member.Pod.Id"
                                                   class="badge-stat hover:underline" title="In this Podman pod">Pod: @member.Pod.Name</a>
                                                @if (member.IsInfra)
                                                {
                                                    <span class="badge-stat" title="Holds the namespaces the pod's containers share. Starting, stopping or removing the pod handles it.">Pod infra</span>
                                                }
                                            }
                                            @if (row.SwarmService is not null)
                                            {
                                                <span class="badge-stat" title="Managed by this swarm service">Swarm: @row.SwarmService</span>
                                            }
                                            @if (Sockless.Port.Containers.ContainerLabels.IsHelper(row.Summary.Labels))
                                            {
                                                <span class="badge-stat" title="Started by Sockless Port to read a volume's files. It's removed when the file browser closes.">File browser helper</span>
                                            }
                                        </span>
                                    </th>
                                    <td class="whitespace-nowrap" title="@row.Summary.Status · created @Format.Timestamp(created)">
                                        <span class="flex items-center gap-2">
                                            <partial name="_StatusBadge" model="row.Badge" />
                                            @if (since.Length > 0)
                                            {
                                                <span class="text-xs text-secondary">@since</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="max-w-[24rem]">
                                        <span class="flex min-w-0 items-center gap-2">
                                            <span class="flex min-w-0 font-mono text-xs" title="@row.Summary.Image">
                                                @if (prefix.Length > 0)
                                                {
                                                    <span class="truncate text-secondary">@prefix</span>
                                                }
                                                <span class="truncate">@image</span>
                                            </span>
                                            @if (update is not null)
                                            {
                                                <span class="badge warning shrink-0 whitespace-nowrap" title="@ImageDisplay.UpdateDetail(row.Update)">@update.Label</span>
                                            }
                                            @if (scanBadge is not null)
                                            {
                                                <span class="shrink-0 whitespace-nowrap" title="@scanDetail"><partial name="_StatusBadge" model="scanBadge" /></span>
                                                <span class="sr-only">@scanDetail</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="font-mono text-xs">
                                        @if (row.Ports.Count > 0)
                                        {
                                            <span title="@string.Join(", ", row.Ports)">@string.Join(", ", row.Ports.Take(3))@(row.Ports.Count > 3 ? $" +{row.Ports.Count - 3}" : "")</span>
                                        }
                                    </td>
                                    <td class="num">
                                        <span class="inline-flex items-center gap-1">
                                            @if (row.Summary.State is "paused")
                                            {
                                                <button sp-can="write" type="submit" form="row-actions" class="btn-soft btn-icon" aria-label="Resume @row.Name" title="Resume"
                                                        formaction="@RowAction(row.Summary.Id, "unpause")">
                                                    <icon name="play" class="h-4 w-4" />
                                                </button>
                                            }
                                            else if (row.Running)
                                            {
                                                <button sp-can="write" type="submit" form="row-actions" class="btn-soft btn-icon" aria-label="Restart @row.Name" title="Restart"
                                                        formaction="@RowAction(row.Summary.Id, "restart")">
                                                    <icon name="arrow-path" class="h-4 w-4" />
                                                </button>
                                                <button sp-can="write" type="submit" form="row-actions" class="btn-soft btn-icon" aria-label="Stop @row.Name" title="Stop"
                                                        formaction="@RowAction(row.Summary.Id, "stop")">
                                                    <icon name="stop" class="h-4 w-4" />
                                                </button>
                                            }
                                            else
                                            {
                                                <button sp-can="write" type="submit" form="row-actions" class="btn-soft btn-icon" aria-label="Start @row.Name" title="Start"
                                                        formaction="@RowAction(row.Summary.Id, "start")">
                                                    <icon name="play" class="h-4 w-4" />
                                                </button>
                                            }
                                            <a asp-page="/Engine/Containers/Logs" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@row.Summary.Id"
                                               class="btn-soft btn-icon" aria-label="Logs of @row.Name" title="Logs">
                                                <icon name="document-text" class="h-4 w-4" />
                                            </a>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        </form>
    }
</div>

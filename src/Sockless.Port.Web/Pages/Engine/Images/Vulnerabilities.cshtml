@page "/endpoints/{endpointId:int}/images/{imageId}/vulnerabilities"
@model Sockless.Port.Web.Pages.Engine.Images.VulnerabilitiesModel
@{
    ViewData["Title"] = $"{Model.DisplayName} vulnerabilities";
}

<div data-endpoint-id="@Model.EndpointId">
    <partial name="_ImageHeader" model="Model" />
    <partial name="_ImageScanSummary" model="Model" />
    @if (Model.Result is { Findings.Count: > 0 })
    {
        <form method="get" role="search" aria-label="Filter vulnerabilities" class="mb-4 flex flex-wrap items-end gap-3"
              asp-page="/Engine/Images/Vulnerabilities" asp-route-endpointId="@Model.EndpointId" asp-route-imageId="@Model.ImageId">
            <div class="field min-w-[14rem] flex-1">
                <label for="vuln-q">Search</label>
                <input id="vuln-q" type="search" name="q" value="@Model.Q" placeholder="CVE, package or file" autocomplete="off" spellcheck="false" />
            </div>
            <div class="field">
                <label for="vuln-severity">Severity</label>
                <select id="vuln-severity" name="severity">
                    @foreach (var (value, label) in Sockless.Port.Web.Pages.Engine.Images.VulnerabilitiesModel.SeverityFilters)
                    {
                        <option value="@value" selected="@(value == (Model.Severity ?? ""))">@label</option>
                    }
                </select>
            </div>
            <label class="mb-2 flex items-center gap-2 text-secondary">
                <input type="checkbox" name="fixable" value="true" checked="@Model.Fixable" class="accent-accent" /> Only with a fix
            </label>
            <button type="submit" class="btn-soft mb-1"><icon name="magnifying-glass" class="h-4 w-4" /> Filter</button>
        </form>
    }
    <partial name="_ImageFindings" model="Model" />
</div>

@model Sockless.Port.Web.Pages.Engine.Images.IndexModel
@{
    var refreshUrl = Url.Page("/Engine/Images/Index", "Table", Model.Filters);
}
@* Live: refreshes on engine events, but not while rows are selected (data-pause-when-selected). *@
<div id="image-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="square-3-stack-3d" class="h-12 w-12" stroke-width="1.5" />
                @if (Model.Filtered && Model.Total > 0)
                {
                    <p class="text-base text-heading">No images match these filters</p>
                    <p class="text-secondary"><a asp-page="/Engine/Images/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
                }
                else
                {
                    <p class="text-base text-heading">No images yet</p>
                    <p class="text-secondary">Pull one above, or build one from a Dockerfile.</p>
                }
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="image-row-actions" method="post" asp-page="/Engine/Images/Index" asp-page-handler="Remove" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="image-bulk-form" method="post" asp-page="/Engine/Images/Index" asp-page-handler="Remove"
              asp-route-endpointId="@Model.EndpointId" asp-route-q="@Model.Q" asp-route-usage="@Model.Usage" data-bulk-noun="images">
            <div sp-can="write" class="mb-3 flex flex-wrap items-center gap-3" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown · @Format.Bytes(Model.TotalSize) in all</span>
                <span class="flex-1"></span>
                <label class="flex items-center gap-2 text-secondary">
                    <input type="checkbox" name="force" value="true" class="accent-accent" /> Also when stopped containers use them
                </label>
                <button type="submit" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Every tag of each image is removed. Images that running containers use are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <caption class="sr-only">Images</caption>
                    <thead>
                        <tr>
                            <th sp-can="write" scope="col" class="w-8"><input type="checkbox" data-select-all aria-label="Select all shown images" /></th>
                            <th scope="col">Image</th>
                            <th scope="col">ID</th>
                            <th scope="col" class="num">Size</th>
                            <th scope="col">Created</th>
                            <th scope="col">Used by</th>
                            <th scope="col">Update</th>
                            <th scope="col" class="num"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var created = Format.FromUnix(row.Summary.Created);
                            var detail = ImageDisplay.UpdateDetail(row.Update);
                            <tr>
                                <td sp-can="write"><input type="checkbox" name="ids" value="@row.Id" data-name="@row.Name" aria-label="Select @row.Name" /></td>
                                <th scope="row" class="max-w-[22rem]">
                                    <a asp-page="/Engine/Images/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-imageId="@row.Id"
                                       class="break-all font-mono text-xs font-semibold hover:underline">@(row.Summary.IsDangling ? "<none>" : row.Name)</a>
                                    @foreach (var tag in row.Summary.Tags.Skip(1))
                                    {
                                        <span class="block break-all font-mono text-xs text-secondary">@tag</span>
                                    }
                                    @if (row.Summary.IsDangling)
                                    {
                                        <span class="mt-1 flex"><span class="badge-stat" title="No tag points at it any more">Dangling</span></span>
                                    }
                                </th>
                                <td class="font-mono text-xs" title="@row.Summary.Id">@row.ShortId</td>
                                <td class="num font-mono text-xs">@Format.Bytes(row.Summary.Size)</td>
                                <td class="whitespace-nowrap text-secondary" title="@Format.Timestamp(created)">@Format.Relative(created)</td>
                                <td>
                                    @if (row.UsedBy.Count == 0)
                                    {
                                        <span class="text-secondary">Unused</span>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-xs">@string.Join(", ", row.UsedBy.Take(3))</span>
                                        @if (row.UsedBy.Count > 3)
                                        {
                                            <span class="block text-xs text-secondary">and @(row.UsedBy.Count - 3) more</span>
                                        }
                                    }
                                </td>
                                <td title="@detail">
                                    @if (ImageDisplay.UpdateBadge(row.Update) is { } badge)
                                    {
                                        <partial name="_StatusBadge" model="badge" />
                                        <span class="sr-only">@detail</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                                <td class="num">
                                    <button sp-can="write" type="submit" form="image-row-actions" class="btn-soft danger" aria-label="Remove @row.Name"
                                            formaction="@Url.Page("/Engine/Images/Index", "Remove", new { endpointId = Model.EndpointId, Model.Q, Model.Usage, ids = row.Id })"
                                            data-confirm="Remove image @row.Name?@(row.Summary.Tags.Count > 1 ? $" All {row.Summary.Tags.Count} tags are removed." : "")@(row.UsedBy.Count > 0 ? " Containers use it, so the engine may refuse." : "")">
                                        <icon name="trash" class="h-4 w-4" /> Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</div>

@model Sockless.Port.Web.Pages.Engine.Networks.IndexModel
@{
    var refreshUrl = Url.Page("/Engine/Networks/Index", "Table", Model.Filters);
}
@* Live: refreshes on engine events, but not while rows are selected (data-pause-when-selected). *@
<div id="network-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="share" class="h-12 w-12" stroke-width="1.5" />
                <p class="text-base text-heading">No networks match these filters</p>
                <p class="text-secondary"><a asp-page="/Engine/Networks/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="network-row-actions" method="post" asp-page="/Engine/Networks/Index" asp-page-handler="Remove" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="network-bulk-form" method="post" asp-page="/Engine/Networks/Index" asp-page-handler="Remove"
              asp-route-endpointId="@Model.EndpointId" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind" data-bulk-noun="networks">
            <div class="mb-3 flex flex-wrap items-center gap-3" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown</span>
                <span class="flex-1"></span>
                <button type="submit" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Networks with containers attached are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <caption class="sr-only">Networks</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="w-8"><input type="checkbox" data-select-all aria-label="Select all shown networks" /></th>
                            <th scope="col">Network</th>
                            <th scope="col">Driver</th>
                            <th scope="col">Subnet</th>
                            <th scope="col">Containers</th>
                            <th scope="col" class="num"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var summary = row.Summary;
                            <tr>
                                <td>
                                    @if (!summary.IsPredefined)
                                    {
                                        <input type="checkbox" name="ids" value="@row.Id" data-name="@row.Name" aria-label="Select @row.Name" />
                                    }
                                </td>
                                <th scope="row" class="max-w-[22rem]">
                                    <a asp-page="/Engine/Networks/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-networkId="@row.Id"
                                       class="break-all font-mono text-xs font-semibold hover:underline">@row.Name</a>
                                    <span class="mt-1 flex flex-wrap gap-1">
                                        @if (summary.IsPredefined)
                                        {
                                            <span class="badge-stat" title="Created by the engine; can't be removed">Built in</span>
                                        }
                                        @if (summary.Scope == "swarm")
                                        {
                                            <span class="badge-stat" title="Spans every node of the swarm">Swarm</span>
                                        }
                                        @if (summary.Ingress)
                                        {
                                            <span class="badge-stat" title="The swarm's routing mesh: published ports arrive here">Ingress</span>
                                        }
                                        @if (summary.IsEncrypted)
                                        {
                                            <span class="badge-stat" title="Traffic between nodes is encrypted">Encrypted</span>
                                        }
                                        @if (summary.Attachable)
                                        {
                                            <span class="badge-stat" title="Standalone containers can join, not only services">Attachable</span>
                                        }
                                        @if (summary.Internal)
                                        {
                                            <span class="badge-stat" title="No route out of the network">Internal</span>
                                        }
                                        @if (summary.EnableIpv6)
                                        {
                                            <span class="badge-stat">IPv6</span>
                                        }
                                        @if (row.Stack is not null)
                                        {
                                            <span class="badge-stat" title="Stack">@row.Stack</span>
                                        }
                                    </span>
                                </th>
                                <td class="font-mono text-xs">@(summary.Driver ?? "—")</td>
                                <td class="font-mono text-xs">
                                    @if (row.Subnets.Count == 0)
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                    @foreach (var subnet in row.Subnets)
                                    {
                                        <span class="block">@subnet</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Attached.Count == 0)
                                    {
                                        <span class="text-secondary">None</span>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-xs">@string.Join(", ", row.Attached.Take(3).Select(c => c.DisplayName))</span>
                                        @if (row.Attached.Count > 3)
                                        {
                                            <span class="block text-xs text-secondary">and @(row.Attached.Count - 3) more</span>
                                        }
                                    }
                                </td>
                                <td class="num">
                                    @if (!summary.IsPredefined)
                                    {
                                        <button type="submit" form="network-row-actions" class="btn-soft danger" aria-label="Remove @row.Name"
                                                formaction="@Url.Page("/Engine/Networks/Index", "Remove", new { endpointId = Model.EndpointId, Model.Q, Model.Kind, ids = row.Id })"
                                                data-confirm="Remove network @row.Name?@(row.Attached.Count > 0 ? $" {row.Attached.Count} {(row.Attached.Count == 1 ? "container is" : "containers are")} attached, so the engine may refuse." : "")">
                                            <icon name="trash" class="h-4 w-4" /> Remove
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</div>

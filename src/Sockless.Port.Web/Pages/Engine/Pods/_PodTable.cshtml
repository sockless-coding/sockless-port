@model Sockless.Port.Web.Pages.Engine.Pods.IndexModel
@{
    var refreshUrl = Url.Page("/Engine/Pods/Index", "Table", Model.Filters);
}
@* Live: refreshes on engine events (pod and container events alike), but not while rows are selected. *@
<div id="pod-table" hx-get="@refreshUrl" hx-trigger="engine-changed from:body, endpoint-state from:body"
     hx-swap="outerHTML" data-pause-when-selected>

    @if (Model.Error is not null)
    {
        <div class="callout danger" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="rectangle-group" class="h-12 w-12" stroke-width="1.5" />
                @if (Model.Filtered && Model.Total > 0)
                {
                    <p class="text-base text-heading">No pods match these filters</p>
                    <p class="text-secondary"><a asp-page="/Engine/Pods/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Clear the filters</a> to see all @Model.Total.</p>
                }
                else
                {
                    <p class="text-base text-heading">No pods yet</p>
                    <p class="text-secondary">Create one with <span class="font-mono">podman pod create</span>, or from Kubernetes YAML with <span class="font-mono">podman kube play</span>.</p>
                }
            </div>
        </section>
    }
    else
    {
        @* Row buttons submit through this form so they don't also send the bulk selection. *@
        <form id="pod-row-actions" method="post" asp-page="/Engine/Pods/Index" asp-page-handler="Bulk" asp-route-endpointId="@Model.EndpointId"></form>

        <form id="pod-bulk-form" method="post" asp-page="/Engine/Pods/Index" asp-page-handler="Bulk"
              asp-route-endpointId="@Model.EndpointId" asp-route-state="@Model.State" asp-route-q="@Model.Q" data-bulk-noun="pods">
            <div class="mb-3 flex flex-wrap items-center gap-2" data-bulk-toolbar>
                <span class="text-secondary" data-bulk-count aria-live="polite">@Model.Rows.Count of @Model.Total shown</span>
                <span class="flex-1"></span>
                <button type="submit" name="action" value="start" class="btn-soft" data-bulk-action disabled>
                    <icon name="play" class="h-4 w-4" /> Start
                </button>
                <button type="submit" name="action" value="stop" class="btn-soft" data-bulk-action disabled>
                    <icon name="stop" class="h-4 w-4" /> Stop
                </button>
                <button type="submit" name="action" value="restart" class="btn-soft" data-bulk-action disabled>
                    <icon name="arrow-path" class="h-4 w-4" /> Restart
                </button>
                <button type="submit" name="action" value="remove" class="btn-soft danger" data-bulk-action disabled
                        data-confirm-bulk="Remove {list}? Their containers are stopped and removed too. Named volumes are kept.">
                    <icon name="trash" class="h-4 w-4" /> Remove
                </button>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <caption class="sr-only">Pods</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="w-8"><input type="checkbox" data-select-all aria-label="Select all shown pods" /></th>
                            <th scope="col">Pod</th>
                            <th scope="col">State</th>
                            <th scope="col">Containers</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="num"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var created = Format.EngineTime(row.Summary.Created);
                            <tr>
                                <td>
                                    @if (!row.IsSelf)
                                    {
                                        <input type="checkbox" name="ids" value="@row.Id" data-name="@row.Name" aria-label="Select @row.Name" />
                                    }
                                </td>
                                <th scope="row" class="max-w-[20rem]">
                                    <a asp-page="/Engine/Pods/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-podId="@row.Id"
                                       class="break-all font-semibold hover:underline">@row.Name</a>
                                    <span class="mt-1 flex flex-wrap gap-1">
                                        @if (row.IsSelf)
                                        {
                                            <span class="badge-stat" title="Sockless Port runs in this pod, so it can't be stopped or removed from here">Sockless Port</span>
                                        }
                                        @if (!row.HasInfra)
                                        {
                                            <span class="badge-stat" title="Created without an infra container: its containers share no namespaces">No infra</span>
                                        }
                                        @foreach (var network in row.Summary.Networks ?? [])
                                        {
                                            <span class="badge-stat" title="Network">@network</span>
                                        }
                                    </span>
                                </th>
                                <td>
                                    <span title="@PodStatus.Explain(row.Summary.Status)"><partial name="_StatusBadge" model="row.State" /></span>
                                    @if (row.Workloads.Count > 0)
                                    {
                                        <span class="mt-1 block text-xs text-secondary">@row.Running of @row.Workloads.Count running</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Workloads.Count == 0)
                                    {
                                        <span class="text-secondary">None</span>
                                    }
                                    else
                                    {
                                        <ul class="space-y-1">
                                            @foreach (var container in row.Workloads)
                                            {
                                                <li class="flex flex-wrap items-center gap-2">
                                                    <a asp-page="/Engine/Containers/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@container.Id"
                                                       class="break-all font-mono text-xs hover:underline">@container.DisplayName</a>
                                                    <partial name="_StatusBadge" model="ContainerStatus.State(container.Status, null)" />
                                                </li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td class="whitespace-nowrap text-secondary" title="@(created is { } c ? Format.Timestamp(c) : null)">@(created is { } cr ? Format.Relative(cr) : "—")</td>
                                <td class="num">
                                    @if (row.Active)
                                    {
                                        @if (!row.IsSelf)
                                        {
                                            <button type="submit" form="pod-row-actions" class="btn-soft" aria-label="Stop @row.Name"
                                                    formaction="@Url.Page("/Engine/Pods/Index", "Bulk", new { endpointId = Model.EndpointId, Model.State, Model.Q, ids = row.Id, action = "stop" })">
                                                <icon name="stop" class="h-4 w-4" /> Stop
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="submit" form="pod-row-actions" class="btn-soft" aria-label="Start @row.Name"
                                                formaction="@Url.Page("/Engine/Pods/Index", "Bulk", new { endpointId = Model.EndpointId, Model.State, Model.Q, ids = row.Id, action = "start" })">
                                            <icon name="play" class="h-4 w-4" /> Start
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</div>

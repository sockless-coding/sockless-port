@page "/endpoints/{endpointId:int}/stacks"
@model Sockless.Port.Web.Pages.Engine.Stacks.IndexModel
@{
    ViewData["Title"] = "Stacks";
    var tableUrl = Url.Page("/Engine/Stacks/Index", "Table", new { endpointId = Model.EndpointId });
}

<div data-endpoint-id="@Model.EndpointId">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="page-title">Stacks</h2>
            <p class="mt-1 text-secondary">Compose projects on @Model.Connection.Name: the ones deployed from here, and the ones found by their labels.</p>
        </div>
        <a asp-page="/Engine/Stacks/Create" asp-route-endpointId="@Model.EndpointId" class="btn-soft secondary">
            <icon name="plus" class="h-4 w-4" /> Create stack
        </a>
    </div>

    @if (Model.ComposeProblem is not null)
    {
        <div class="callout warning mb-4" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>Stacks can be written and saved, but not validated or deployed: @Model.ComposeProblem</p>
        </div>
    }
    @if (Model.DockerCliProblem is not null)
    {
        <div class="callout warning mb-4" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>Swarm stacks can be written and saved, but not deployed: @Model.DockerCliProblem</p>
        </div>
    }

    @if (Model.Client is null)
    {
        <div class="mb-4"><partial name="_EndpointStateCallout" model="Model.Connection" /></div>
    }

    <form method="get" role="search" aria-label="Filter stacks" class="mb-4 flex flex-wrap items-end gap-3"
          hx-get="@tableUrl" hx-target="#stack-table" hx-swap="outerHTML"
          hx-trigger="input changed delay:300ms from:find input[type=search], submit">
        <div class="field min-w-[14rem] flex-1">
            <label for="filter-q">Search</label>
            <input id="filter-q" type="search" name="q" value="@Model.Q" placeholder="Stack, service or image" autocomplete="off" />
        </div>
        <noscript><button type="submit" class="btn-soft">Filter</button></noscript>
    </form>

    <partial name="_StackTable" model="Model" />
</div>

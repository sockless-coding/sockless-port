@* The compose.yaml and .env editors of a stack form. Model: the form's input. Without scripts they're plain text areas.
   A git-backed stack's files from the repository are read-only: they change in the repository, then a fetch brings them here. *@
@model Sockless.Port.Web.Infrastructure.StackInput
@{
    var repository = Model.Repository;
}
<section class="card space-y-3" aria-labelledby="compose-title">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 id="compose-title" class="section-title mb-0"><label for="Input_Compose">@(repository is null ? "compose.yaml" : repository.ComposePath)</label></h3>
        <a href="https://docs.docker.com/reference/compose-file/" class="text-xs hover:underline" rel="noreferrer" target="_blank">Compose file reference</a>
    </div>
    @if (repository is not null)
    {
        <p class="text-secondary" id="compose-source">
            From the repository, branch <span class="font-mono">@repository.Branch</span>@if (repository.FetchedCommit is { } commit)
            {
                <text> at </text><partial name="_GitCommit" model="(repository.Url, commit)" />
            }. Change it there, then fetch.
        </p>
    }
    <div class="code-editor">
        <textarea id="Input_Compose" name="Input.Compose" class="code-input" rows="22" spellcheck="false" autocomplete="off"
                  aria-describedby="@(repository is null ? "compose-hint" : "compose-source compose-hint")" data-code-editor="yaml" readonly="@Model.ComposeReadOnly"
                  placeholder="services:&#10;  web:&#10;    image: nginx:1.27&#10;    ports:&#10;      - &quot;8080:80&quot;">@Model.Compose</textarea>
    </div>
    <p class="hint text-xs text-secondary" id="compose-hint">
        @if (repository is null)
        {
            <text>Use images rather than <span class="font-mono">build:</span>, and absolute host paths or named volumes rather than
            <span class="font-mono">./relative</span> bind mounts: Compose runs inside Sockless Port, not on the engine's host.</text>
        }
        else
        {
            <text>Compose runs in the repository's checkout, so <span class="font-mono">env_file:</span> and other files next to it are found.
            Bind mounts still name paths on the engine's host, and <span class="font-mono">build:</span> isn't available.</text>
        }
    </p>
    <partial name="_FieldError" model='"Input_Compose"' />
</section>

<section class="card space-y-3" aria-labelledby="env-title">
    <h3 id="env-title" class="section-title mb-0"><label for="Input_Env">@(Model.EnvReadOnly ? repository!.EnvPath : ".env")</label></h3>
    @if (Model.EnvReadOnly)
    {
        <p class="text-secondary" id="env-source">From the repository, as the stack's <span class="font-mono">.env</span>. Change it there, then fetch.</p>
    }
    <div class="code-editor">
        <textarea id="Input_Env" name="Input.Env" class="code-input" rows="6" spellcheck="false" autocomplete="off"
                  aria-describedby="@(Model.EnvReadOnly ? "env-source env-hint" : "env-hint")" data-code-editor="env" readonly="@Model.EnvReadOnly"
                  placeholder="TAG=1.27&#10;POSTGRES_PASSWORD=change-me">@Model.Env</textarea>
    </div>
    <p class="hint text-xs text-secondary" id="env-hint">
        One <span class="font-mono">KEY=value</span> per line. Compose fills <span class="font-mono">${KEY}</span> in the file from here.
        @if (Model.EnvReadOnly)
        {
            <text>It's in the repository, so anyone who can read the repository sees it.</text>
        }
        else
        {
            <text>Values are stored as plain text in the data volume and shown to anyone who can open this page.</text>
            @if (repository is not null)
            {
                <text>They stay here: fetching never changes them.</text>
            }
        }
    </p>
</section>

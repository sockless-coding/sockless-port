@model Sockless.Port.Web.Pages.Engine.Stacks.DetailModel
@using Sockless.Port.Stacks
@{
    var project = Model.Project;
    var definition = Model.Definition;
    var swarm = Model.IsSwarm;
}
<div id="stack-overview" hx-get="@Url.Page("/Engine/Stacks/Detail", "Overview", new { endpointId = Model.EndpointId, stackName = Model.StackName })"
     hx-trigger="engine-changed from:body, endpoint-state from:body, stack-job-ended from:body" hx-swap="outerHTML">

    @if (Model.IsGone)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="rectangle-stack" class="h-12 w-12" stroke-width="1.5" />
                <p class="text-base text-heading">@Model.StackName is gone</p>
                <p class="text-secondary">It has no @(swarm ? "services" : "containers") and Sockless Port no longer manages it. <a asp-page="/Engine/Stacks/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Back to the stacks</a>.</p>
            </div>
        </section>
    }
    else
    {
        <div class="space-y-4">
            @if (Model.IsSelf)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Sockless Port runs in this stack, so it can't stop, take down or redeploy it: the request would end with Sockless Port. Manage it with @(swarm ? "docker stack" : "docker compose") on the host.</p>
                </div>
            }
            else if (Model.ToolProblem is not null && Model.Client is not null)
            {
                <div class="callout warning" role="alert">
                    <icon name="exclamation-triangle" class="h-5 w-5" />
                    <p>@(swarm ? "This stack" : "Stacks") can't be deployed or changed from here: @Model.ToolProblem</p>
                </div>
            }

            @if (definition is null && swarm)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>This swarm stack was deployed outside Sockless Port, with docker stack deploy. It can be restarted and removed from the swarm by name. Adopting swarm stacks isn't built yet: to manage it here, create a swarm stack with the same name and its compose file.</p>
                </div>
            }
            else if (definition is null)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>
                        This project was deployed outside Sockless Port@(project.WorkingDirectory is null ? "" : ", from")
                        @if (project.WorkingDirectory is { } wd)
                        {
                            <span class="break-all font-mono text-xs">@wd</span>
                        }
                        on the machine that ran Compose. It can be started, stopped and taken down by name. Adopt it to edit and redeploy it from here.
                    </p>
                </div>
            }
            else if (definition.DeployedAt is null && !Model.IsDeployed)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Saved but not deployed. Deploy it to create its @(swarm ? "services on the swarm" : "containers").</p>
                </div>
            }
            else if (definition.DeployedAt is null)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Adopted: its containers were deployed elsewhere. They're replaced by what's in the files here at the next deploy, but only where they differ.</p>
                </div>
            }
            else if (Model.HasUndeployedChanges)
            {
                <div class="callout warning">
                    <icon name="exclamation-triangle" class="h-5 w-5" />
                    <p>
                        The saved files differ from what was deployed @Format.Relative(definition.DeployedAt.Value).
                        <span sp-can="write"><a asp-page="/Engine/Stacks/Editor" asp-route-endpointId="@Model.EndpointId" asp-route-stackName="@Model.StackName" asp-route-review="true" class="hover:underline">Review the changes</a>.</span>
                    </p>
                </div>
            }

            @if (Model.Client is not null && Model.ServicesWithUpdates is { Count: > 0 } outdated)
            {
                <div class="callout warning">
                    <icon name="arrow-up-circle" class="h-5 w-5" />
                    <p>
                        The registry has a newer image for @(outdated.Count == 1 ? "the service" : "the services")
                        <span class="font-mono">@string.Join(", ", outdated)</span>.
                        @if (definition is not null)
                        {
                            @:To update, use <span class="font-semibold">@(swarm ? "Update images" : "Pull and update")</span>.
                        }
                        else if (swarm)
                        {
                            @:To update, run <span class="font-mono">docker stack deploy</span> again where the stack's file is, or update the services one by one.
                        }
                        else
                        {
                            @:To update, run <span class="font-mono">docker compose pull</span> and <span class="font-mono">docker compose up -d</span> where the project's file is, or adopt it to update it from here.
                        }
                    </p>
                </div>
            }

            <section class="card" aria-labelledby="services-title">
                <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                    <h3 id="services-title" class="section-title mb-0">Services</h3>
                    @if (Model.Client is not null && Model.IsDeployed)
                    {
                        <partial name="_StatusBadge" model="swarm ? StackDisplay.State(Model.Swarm) : StackDisplay.State(project)" />
                    }
                </div>
                @if (Model.Client is null)
                {
                    <p class="text-secondary">The engine is offline, so its @(swarm ? "services" : "containers") aren't known.</p>
                }
                else if (swarm && !Model.CanReachSwarm)
                {
                    <p class="text-secondary">@Model.Connection.Name isn't a swarm manager, so the stack's services can't be listed.</p>
                }
                else if (swarm && Model.Swarm.Services.Count == 0)
                {
                    <p class="text-secondary">No services on the swarm. @(definition is null ? "" : "Deploy the stack to create them.")</p>
                }
                else if (swarm)
                {
                    <div class="table-wrap">
                        <table class="table">
                            <caption class="sr-only">Swarm services</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Service</th>
                                    <th scope="col">State</th>
                                    <th scope="col">Mode</th>
                                    <th scope="col">Image</th>
                                    <th scope="col">Ports</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in Model.Swarm.Services)
                                {
                                    var ports = service.Endpoint?.Ports ?? [];
                                    <tr>
                                        <th scope="row">
                                            <a asp-page="/Engine/Swarm/Services/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-serviceId="@service.Id"
                                               class="font-mono hover:underline" title="@service.Name">@SwarmDisplay.InStack(service.Name, Model.StackName)</a>
                                        </th>
                                        <td><partial name="_StatusBadge" model="SwarmDisplay.ServiceState(service)" /></td>
                                        <td class="whitespace-nowrap">@SwarmDisplay.Mode(service)</td>
                                        <td class="break-all font-mono text-xs">
                                            @(service.Image ?? "—")
                                            <partial name="_UpdateFlag" model="Model.UpdateOf(service)" />
                                        </td>
                                        <td class="font-mono text-xs">@(ports.Count > 0 ? string.Join(", ", ports.Select(SwarmDisplay.Port)) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="mt-3 text-xs text-secondary">
                        <a asp-page="/Engine/Swarm/Services/Index" asp-route-endpointId="@Model.EndpointId" asp-route-stack="@Model.StackName" class="hover:underline">Open in Services</a>
                        to scale or update single services. The next deploy sets them back to what the file says.
                        Image updates: @ImageDisplay.LastChecked(Model.Updates, "The images")
                    </p>
                }
                else if (project.Services.Count == 0)
                {
                    <p class="text-secondary">No containers. @(definition is null ? "" : "Deploy the stack to create them.")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <caption class="sr-only">Services and their containers</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Service</th>
                                    <th scope="col">Container</th>
                                    <th scope="col">State</th>
                                    <th scope="col">Image</th>
                                    <th scope="col">Ports</th>
                                </tr>
                            </thead>
                            @foreach (var service in project.Services)
                            {
                                <tbody>
                                @{
                                    var first = true;
                                }
                                    @foreach (var container in service.Containers)
                                    {
                                        var (state, health) = ContainerStatus.FromSummary(container);
                                        var ports = ContainerStatus.PublishedPorts(container.Ports);
                                        <tr>
                                            @if (first)
                                            {
                                                <th scope="rowgroup" rowspan="@service.Containers.Count" class="align-top font-mono">@service.Name</th>
                                            }
                                            <td>
                                                <a asp-page="/Engine/Containers/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@container.Id"
                                                   class="font-mono hover:underline">@container.DisplayName</a>
                                            </td>
                                            <td>
                                                <span class="flex flex-wrap gap-1">
                                                    <partial name="_StatusBadge" model="state" />
                                                    @if (health is not null)
                                                    {
                                                        <partial name="_StatusBadge" model="health" />
                                                    }
                                                </span>
                                            </td>
                                            <td class="break-all font-mono text-xs">
                                                @(container.Image ?? "—")
                                                <partial name="_UpdateFlag" model="Model.UpdateOf(container)" />
                                            </td>
                                            <td class="font-mono text-xs">@(ports.Count > 0 ? string.Join(", ", ports) : "—")</td>
                                        </tr>
                                        first = false;
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                    <p class="mt-3 text-xs text-secondary">
                        <a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" asp-route-stack="@Model.StackName" class="hover:underline">Open in Containers</a>
                        to act on single containers. Compose recreates what differs from the files at the next deploy.
                        Image updates: @(Model.Client is not null && !Model.CanCheckUpdates
                            ? Sockless.Port.Images.ImageUpdates.Unsupported(Model.Connection)
                            : ImageDisplay.LastChecked(Model.Updates, "The images"))
                    </p>
                }
            </section>

            @if (Model.Repository is { } repository)
            {
                <section class="card space-y-4" aria-labelledby="repository-title">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 id="repository-title" class="section-title mb-0">Repository</h3>
                        <a sp-can="write" asp-page="/Engine/Stacks/Repository" asp-route-endpointId="@Model.EndpointId" asp-route-stackName="@Model.StackName"
                           class="text-xs hover:underline">Repository settings</a>
                    </div>
                    @if (repository.LastError is { } gitError)
                    {
                        <div class="callout danger" role="alert">
                            <icon name="exclamation-triangle" class="h-5 w-5" />
                            <p>
                                The last check of the repository failed@(repository.CheckedAt is { } failedAt ? $" {Format.Relative(failedAt)}" : ""): @gitError
                            </p>
                        </div>
                    }
                    @if (Model.GitProblem is { } gitProblem)
                    {
                        <div class="callout warning" role="alert">
                            <icon name="exclamation-triangle" class="h-5 w-5" />
                            <p>The repository can't be fetched from here: @gitProblem</p>
                        </div>
                    }
                    @if (Model.PendingSync is { } pending)
                    {
                        <div class="callout">
                            <icon name="clock" class="h-5 w-5" />
                            <p>
                                A redeploy asked for by the @pending.By @Format.Relative(pending.RequestedAt) is waiting to start@(pending.LastRejection is { } why ? $": {why}" : ".")
                                It's dropped if it can't start within an hour.
                            </p>
                        </div>
                    }
                    <dl class="details">
                        <dt>Address</dt>
                        <dd class="break-all font-mono text-xs">@repository.Url</dd>
                        <dt>Branch</dt>
                        <dd class="font-mono">@repository.Branch</dd>
                        <dt>Compose file</dt>
                        <dd class="break-all font-mono text-xs">@repository.ComposePath</dd>
                        <dt>.env</dt>
                        <dd>
                            @if (repository.EnvPath is { } envPath)
                            {
                                <span class="break-all font-mono text-xs">@envPath</span>
                            }
                            else
                            {
                                <text>Kept here, edited in the editor</text>
                            }
                        </dd>
                        <dt>Fetched</dt>
                        <dd>
                            @if (repository.FetchedCommit is { } fetched)
                            {
                                <partial name="_GitCommit" model="(repository.Url, fetched)" />
                                <span>@repository.FetchedSubject</span>
                                @if (repository.FetchedAt is { } fetchedAt)
                                {
                                    <span class="text-xs text-secondary" title="@Format.Timestamp(fetchedAt)">· fetched @Format.Relative(fetchedAt)</span>
                                }
                            }
                            else
                            {
                                <text>Not yet</text>
                            }
                        </dd>
                        <dt>Deployed</dt>
                        <dd>
                            @if (repository.DeployedCommit is { } deployedCommit)
                            {
                                <partial name="_GitCommit" model="(repository.Url, deployedCommit)" />
                                <span>@repository.DeployedSubject</span>
                                @if (deployedCommit == repository.FetchedCommit)
                                {
                                    <span class="text-xs text-secondary">· the fetched commit</span>
                                }
                            }
                            else
                            {
                                <text>Not from the repository yet</text>
                            }
                        </dd>
                        <dt>Checks</dt>
                        <dd>
                            @StackDisplay.Poll(repository.PollMinutes)
                            @if (repository.PollMinutes is not null && repository.CheckedAt is { } checkedAt)
                            {
                                <span class="text-xs text-secondary" title="@Format.Timestamp(checkedAt)">· last @Format.Relative(checkedAt)</span>
                            }
                        </dd>
                        <dt>Webhook</dt>
                        <dd>@(repository.HasWebhook ? "On" : "Off")</dd>
                    </dl>
                    @if (Model.NewCommits is { Count: > 0 } commits)
                    {
                        <div class="space-y-2">
                            <p class="label-caps">Fetched since the deploy</p>
                            <ul class="space-y-1">
                                @foreach (var commit in commits)
                                {
                                    <li class="flex flex-wrap items-baseline gap-2">
                                        <partial name="_GitCommit" model="(repository.Url, commit.Sha)" />
                                        <span class="min-w-0 break-words">@commit.Subject</span>
                                        <span class="text-xs text-secondary" title="@Format.Timestamp(commit.At)">@commit.Author, @Format.Relative(commit.At)</span>
                                    </li>
                                }
                            </ul>
                            @if (commits.Count == DetailModel.MaxCommits)
                            {
                                <p class="text-xs text-secondary">Only the newest @DetailModel.MaxCommits are listed.</p>
                            }
                        </div>
                    }
                </section>
            }

            @if (definition is not null)
            {
                <section class="card" aria-labelledby="files-title">
                    <h3 id="files-title" class="section-title">Files</h3>
                    <dl class="details">
                        <dt>Folder</dt>
                        <dd class="break-all font-mono text-xs">@Model.StackFolder</dd>
                        <dt>Saved</dt>
                        <dd title="@Format.Timestamp(definition.UpdatedAt)">@Format.Relative(definition.UpdatedAt)</dd>
                        <dt>Deployed</dt>
                        <dd>@(definition.DeployedAt is { } at ? Format.Relative(at) : "Never from here")</dd>
                    </dl>
                </section>
            }
        </div>
    }
</div>

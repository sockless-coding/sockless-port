@model Sockless.Port.Web.Pages.Engine.Stacks.DetailModel
@using Sockless.Port.Stacks
@{
    var project = Model.Project;
    var definition = Model.Definition;
}
<div id="stack-overview" hx-get="@Url.Page("/Engine/Stacks/Detail", "Overview", new { endpointId = Model.EndpointId, stackName = Model.StackName })"
     hx-trigger="engine-changed from:body, endpoint-state from:body, stack-job-ended from:body" hx-swap="outerHTML">

    @if (Model.IsGone)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="rectangle-stack" class="h-12 w-12" stroke-width="1.5" />
                <p class="text-base text-heading">@Model.StackName is gone</p>
                <p class="text-secondary">It has no containers and Sockless Port no longer manages it. <a asp-page="/Engine/Stacks/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Back to the stacks</a>.</p>
            </div>
        </section>
    }
    else
    {
        <div class="space-y-4">
            @if (project.IsSelf)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Sockless Port runs in this stack, so it can't stop, take down or redeploy it: the request would end with Sockless Port. Manage it with docker compose on the host.</p>
                </div>
            }
            else if (Model.ComposeProblem is not null && Model.Client is not null)
            {
                <div class="callout warning" role="alert">
                    <icon name="exclamation-triangle" class="h-5 w-5" />
                    <p>Stacks can't be deployed or changed from here: @Model.ComposeProblem</p>
                </div>
            }

            @if (definition is null)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>
                        This project was deployed outside Sockless Port@(project.WorkingDirectory is null ? "" : ", from")
                        @if (project.WorkingDirectory is { } wd)
                        {
                            <span class="break-all font-mono text-xs">@wd</span>
                        }
                        on the machine that ran Compose. It can be started, stopped and taken down by name. Adopt it to edit and redeploy it from here.
                    </p>
                </div>
            }
            else if (definition.DeployedAt is null && project.Containers.Count == 0)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Saved but not deployed. Deploy it to create its containers.</p>
                </div>
            }
            else if (definition.DeployedAt is null)
            {
                <div class="callout">
                    <icon name="information-circle" class="h-5 w-5" />
                    <p>Adopted: its containers were deployed elsewhere. They're replaced by what's in the files here at the next deploy, but only where they differ.</p>
                </div>
            }
            else if (Model.HasUndeployedChanges)
            {
                <div class="callout warning">
                    <icon name="exclamation-triangle" class="h-5 w-5" />
                    <p>
                        The saved files differ from what was deployed @Format.Relative(definition.DeployedAt.Value).
                        <a asp-page="/Engine/Stacks/Editor" asp-route-endpointId="@Model.EndpointId" asp-route-stackName="@Model.StackName" asp-route-review="true" class="hover:underline">Review the changes</a>.
                    </p>
                </div>
            }

            <section class="card" aria-labelledby="services-title">
                <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                    <h3 id="services-title" class="section-title mb-0">Services</h3>
                    @if (Model.Client is not null && project.Containers.Count > 0)
                    {
                        <partial name="_StatusBadge" model="StackDisplay.State(project)" />
                    }
                </div>
                @if (Model.Client is null)
                {
                    <p class="text-secondary">The engine is offline, so its containers aren't known.</p>
                }
                else if (project.Services.Count == 0)
                {
                    <p class="text-secondary">No containers. @(definition is null ? "" : "Deploy the stack to create them.")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <caption class="sr-only">Services and their containers</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Service</th>
                                    <th scope="col">Container</th>
                                    <th scope="col">State</th>
                                    <th scope="col">Image</th>
                                    <th scope="col">Ports</th>
                                </tr>
                            </thead>
                            @foreach (var service in project.Services)
                            {
                                <tbody>
                                @{
                                    var first = true;
                                }
                                    @foreach (var container in service.Containers)
                                    {
                                        var (state, health) = ContainerStatus.FromSummary(container);
                                        var ports = ContainerStatus.PublishedPorts(container.Ports);
                                        <tr>
                                            @if (first)
                                            {
                                                <th scope="rowgroup" rowspan="@service.Containers.Count" class="align-top font-mono">@service.Name</th>
                                            }
                                            <td>
                                                <a asp-page="/Engine/Containers/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-containerId="@container.Id"
                                                   class="font-mono hover:underline">@container.DisplayName</a>
                                            </td>
                                            <td>
                                                <span class="flex flex-wrap gap-1">
                                                    <partial name="_StatusBadge" model="state" />
                                                    @if (health is not null)
                                                    {
                                                        <partial name="_StatusBadge" model="health" />
                                                    }
                                                </span>
                                            </td>
                                            <td class="break-all font-mono text-xs">@(container.Image ?? "—")</td>
                                            <td class="font-mono text-xs">@(ports.Count > 0 ? string.Join(", ", ports) : "—")</td>
                                        </tr>
                                        first = false;
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                    <p class="mt-3 text-xs text-secondary">
                        <a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" asp-route-stack="@Model.StackName" class="hover:underline">Open in Containers</a>
                        to act on single containers. Compose recreates what differs from the files at the next deploy.
                    </p>
                }
            </section>

            @if (definition is not null)
            {
                <section class="card" aria-labelledby="files-title">
                    <h3 id="files-title" class="section-title">Files</h3>
                    <dl class="details">
                        <dt>Folder</dt>
                        <dd class="break-all font-mono text-xs">@Model.StackFolder</dd>
                        <dt>Saved</dt>
                        <dd title="@Format.Timestamp(definition.UpdatedAt)">@Format.Relative(definition.UpdatedAt)</dd>
                        <dt>Deployed</dt>
                        <dd>@(definition.DeployedAt is { } at ? Format.Relative(at) : "Never from here")</dd>
                    </dl>
                </section>
            }
        </div>
    }
</div>

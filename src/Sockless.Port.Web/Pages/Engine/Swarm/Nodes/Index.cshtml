@page "/endpoints/{endpointId:int}/swarm/nodes"
@model Sockless.Port.Web.Pages.Engine.Swarm.Nodes.IndexModel
@{
    ViewData["Title"] = "Nodes";
    // A list: tables use the width there is.
    ViewData["Wide"] = true;
}

<div data-endpoint-id="@Model.EndpointId">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="page-title">Nodes</h2>
            <p class="mt-1 text-secondary">The machines in the swarm. Drain a node before maintenance: its tasks move to the others.</p>
        </div>
        @if (Model.Manager is not null)
        {
            <a asp-page="/Engine/Swarm/Index" asp-route-endpointId="@Model.EndpointId" class="btn-soft secondary">
                <icon name="plus" class="h-4 w-4" /> Add nodes
            </a>
        }
    </div>

    @if (Model.Manager is null)
    {
        <partial name="_SwarmCallout" model="Model" />
    }
    else
    {
        <partial name="_NodeTable" model="Model" />
    }
</div>

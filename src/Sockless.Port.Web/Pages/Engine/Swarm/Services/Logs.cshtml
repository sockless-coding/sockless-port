@page "/endpoints/{endpointId:int}/swarm/services/{serviceId}/logs"
@model Sockless.Port.Web.Pages.Engine.Swarm.Services.LogsModel
@{
    ViewData["Title"] = $"{Model.DisplayName} logs";
}

<div data-endpoint-id="@Model.EndpointId">
    <partial name="_ServiceHeader" model="Model" />

    @if (Model.Service is not null && Model.Manager is not null)
    {
        <section class="card" aria-labelledby="logs-title" data-logs
                 data-endpoint="@Model.EndpointId" data-service="@Model.Service.Id">
            <h3 id="logs-title" class="sr-only">Logs</h3>
            <div class="mb-3 flex flex-wrap items-end gap-3">
                <div class="field min-w-[12rem] flex-1">
                    <label for="logs-search">Search</label>
                    <input id="logs-search" type="search" placeholder="Show lines containing… (a task name works too)" autocomplete="off" data-logs-search />
                </div>
                <div class="field">
                    <label for="logs-tail">Lines</label>
                    <select id="logs-tail" data-logs-tail>
                        @foreach (var tail in Sockless.Port.Web.Pages.Engine.Containers.LogsModel.TailChoices)
                        {
                            <option value="@tail" selected="@(tail == 500)">Last @Format.Count(tail) per task</option>
                        }
                    </select>
                </div>
                <label class="flex items-center gap-2 pb-2 text-secondary"><input type="checkbox" class="accent-accent" data-logs-timestamps /> Timestamps</label>
                <label class="flex items-center gap-2 pb-2 text-secondary"><input type="checkbox" class="accent-accent" data-logs-follow checked /> Follow</label>
                <label class="flex items-center gap-2 pb-2 text-secondary"><input type="checkbox" class="accent-accent" data-logs-wrap checked /> Wrap</label>
                <span class="flex gap-2 pb-1">
                    <button type="button" class="btn-soft" data-logs-clear>Clear</button>
                </span>
            </div>
            <div class="log-view wrap" role="log" aria-label="Log output of every task" tabindex="0" data-logs-output></div>
            <p class="mt-2 text-xs text-secondary" aria-live="polite" data-logs-status>Connecting…</p>
            <p class="mt-1 text-xs text-secondary">Lines arrive as each node sends them, so tasks on different nodes can interleave out of order. Turn on timestamps to compare them.</p>
        </section>
    }
</div>

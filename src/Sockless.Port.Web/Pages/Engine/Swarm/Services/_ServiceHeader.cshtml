@* Name, badges, actions and tabs of a service. Model: any service page. *@
@model Sockless.Port.Web.Infrastructure.ServicePageModel
@using Sockless.Port.Web.Pages.Engine.Swarm.Services
@{
    var current = ViewContext.RouteData.Values["page"] as string;
    var tab = DetailModel.Tabs.FirstOrDefault(t => t.Page == current).Tab;
    var service = Model.Service;
    var name = Model.DisplayName;
    var route = new { endpointId = Model.EndpointId, serviceId = Model.ServiceId };
}

<nav aria-label="Breadcrumb" class="mb-3 font-mono text-xs text-secondary">
    <a asp-page="/Engine/Swarm/Services/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Services</a>
    <span class="text-line-accent" aria-hidden="true">/</span>
    <span aria-current="page">@name</span>
</nav>

<div class="mb-4 flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
        <h2 class="page-title break-all">@name</h2>
        @if (service is not null)
        {
            <div class="mt-2 flex flex-wrap items-center gap-1">
                <partial name="_StatusBadge" model="SwarmDisplay.ServiceState(service)" />
                <span class="badge-stat" title="Mode">@SwarmDisplay.Mode(service)</span>
                @if (service.Stack is { } stack)
                {
                    <a asp-page="/Engine/Stacks/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-stackName="@stack" class="badge-stat hover:underline" title="Stack">@stack</a>
                }
            </div>
        }
    </div>

    @if (service is not null && Model.Manager is not null)
    {
        <div sp-can="write" class="flex flex-wrap items-center gap-2">
            @if (Model.IsReplicated)
            {
                <form sp-can="write" method="post" action="@Url.Page("/Engine/Swarm/Services/Detail", "Scale", route)" class="flex items-end gap-2">
                    <div class="field w-24">
                        <label for="scale-replicas">Replicas</label>
                        <input id="scale-replicas" name="replicas" type="number" min="0" max="10000" inputmode="numeric"
                               value="@(service.Spec?.Mode?.Replicated?.Replicas ?? 0)" class="font-mono" />
                    </div>
                    <button type="submit" class="btn-soft"><icon name="arrows-up-down" class="h-4 w-4" /> Scale</button>
                </form>
            }
            <details class="menu" data-menu>
                <summary class="btn-soft" aria-label="More actions for @name">More <icon name="chevron-down" class="h-4 w-4" /></summary>
                <div class="menu-panel w-80 space-y-3 p-3">
                    <form sp-can="write" method="post" action="@Url.Page("/Engine/Swarm/Services/Detail", "Redeploy", route)">
                        <p class="mb-2 text-xs text-secondary">Replaces every task, as the update config says, without changing anything.</p>
                        <button type="submit" class="btn-soft"><icon name="arrow-path" class="h-4 w-4" /> Restart tasks</button>
                    </form>
                    <form sp-can="write" method="post" action="@Url.Page("/Engine/Swarm/Services/Detail", "Redeploy", route)">
                        <input type="hidden" name="pull" value="true" />
                        <p class="mb-2 text-xs text-secondary">Asks the registry which image @(service.Image ?? "the tag") is now, and replaces the tasks with it.</p>
                        <button type="submit" class="btn-soft"><icon name="cloud-arrow-down" class="h-4 w-4" /> Update image</button>
                    </form>
                    @if (service.PreviousSpec is not null)
                    {
                        <form sp-can="write" method="post" action="@Url.Page("/Engine/Swarm/Services/Detail", "Rollback", route)">
                            <p class="mb-2 text-xs text-secondary">Goes back to the settings before the last update.</p>
                            <button type="submit" class="btn-soft" data-confirm="Roll @name back to the settings it had before its last update?">
                                <icon name="arrow-uturn-left" class="h-4 w-4" /> Roll back
                            </button>
                        </form>
                    }
                    <form sp-can="write" method="post" action="@Url.Page("/Engine/Swarm/Services/Detail", "Remove", route)" class="border-t border-line pt-3">
                        <input type="hidden" name="tab" value="@tab" />
                        <button type="submit" class="btn-soft danger"
                                data-confirm="Remove the service @name? Its tasks stop on every node.@(service.Stack is { } s ? $" It belongs to the stack {s}, which brings it back at its next deploy." : "")">
                            <icon name="trash" class="h-4 w-4" /> Remove service
                        </button>
                    </form>
                </div>
            </details>
        </div>
    }
</div>

<nav aria-label="Service" class="tabs mb-6">
    @foreach (var (key, tabPage, label) in DetailModel.Tabs)
    {
        <a asp-page="@tabPage" asp-route-endpointId="@Model.EndpointId" asp-route-serviceId="@Model.ServiceId"
           class="tab" aria-current="@(key == tab ? "page" : null)">@label</a>
    }
</nav>

<partial name="_SwarmCallout" model="Model" />

@* A secret or config. Model: its detail page. *@
@model Sockless.Port.Web.Infrastructure.SwarmObjectDetailModel
@{
    var folder = SwarmObjects.Folder(Model.Kind);
    var item = Model.Object;
    var secret = Model.Kind == SwarmObjectKind.Secret;
}

<div data-endpoint-id="@Model.EndpointId">
    <nav aria-label="Breadcrumb" class="mb-3 font-mono text-xs text-secondary">
        <a asp-page="@($"{folder}/Index")" asp-route-endpointId="@Model.EndpointId" class="hover:underline">@SwarmObjects.Title(Model.Kind)</a>
        <span class="text-line-accent" aria-hidden="true">/</span>
        <span aria-current="page">@Model.DisplayName</span>
    </nav>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
            <h2 class="page-title break-all">@Model.DisplayName</h2>
            @if (item is not null)
            {
                <div class="mt-2 flex flex-wrap items-center gap-1">
                    <span class="badge-stat">@(Model.Users.Count == 0 ? "Unused" : $"Used by {Model.Users.Select(u => u.Service.Id).Distinct().Count()}")</span>
                </div>
            }
        </div>
        @if (item is not null && Model.Manager is not null)
        {
            <form method="post" action="@Url.Page($"{folder}/Detail", "Remove", new { endpointId = Model.EndpointId, objectId = item.Id })">
                <button type="submit" class="btn-soft danger"
                        data-confirm="Remove the @Model.Noun @item.Name?@(Model.Users.Count > 0 ? " Services use it, so the engine will refuse until they no longer do." : "")">
                    <icon name="trash" class="h-4 w-4" /> Remove @Model.Noun
                </button>
            </form>
        }
    </div>

    <partial name="_SwarmCallout" model="Model" />

    @if (item is not null)
    {
        <div class="space-y-4">
            @if (secret)
            {
                <div class="callout">
                    <icon name="lock-closed" class="h-5 w-5" />
                    <p>The swarm never gives a secret's value back, so it isn't shown here. Only tasks of the services below can read it.</p>
                </div>
            }

            <section class="card" aria-labelledby="object-users-title">
                <h3 id="object-users-title" class="section-title">Used by</h3>
                @if (Model.Users.Count == 0)
                {
                    <p class="text-secondary">No service uses it.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <caption class="sr-only">Services using it</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Service</th>
                                    <th scope="col">File in its tasks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var use in Model.Users)
                                {
                                    <tr>
                                        <th scope="row">
                                            <a asp-page="/Engine/Swarm/Services/Detail" asp-route-endpointId="@Model.EndpointId" asp-route-serviceId="@use.Service.Id"
                                               class="font-mono hover:underline">@use.Service.Name</a>
                                        </th>
                                        <td class="font-mono text-xs">@(use.Target ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (!secret)
            {
                <section class="card" aria-labelledby="object-value-title">
                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <h3 id="object-value-title" class="section-title mb-0">Value</h3>
                        <span class="flex gap-2">
                            @if (item.Text is not null)
                            {
                                <button type="button" class="btn-soft" data-copy="#object-value">Copy</button>
                            }
                            <a class="btn-soft" hx-boost="false" href="@Url.Page($"{folder}/Detail", "Download", new { endpointId = Model.EndpointId, objectId = item.Id })">
                                <icon name="arrow-down-tray" class="h-4 w-4" /> Download
                            </a>
                        </span>
                    </div>
                    @if (item.Text is { } text)
                    {
                        <pre id="object-value" class="code-block max-h-[60vh]" tabindex="0">@text</pre>
                    }
                    else
                    {
                        <p class="text-secondary">Binary, @Format.BinaryBytes(item.Bytes?.Length ?? 0). Download it to look inside.</p>
                    }
                </section>
            }

            <section class="card" aria-labelledby="object-details-title">
                <h3 id="object-details-title" class="section-title">Details</h3>
                <dl class="details">
                    @if (Format.EngineTime(item.CreatedAt) is { } created)
                    {
                        <dt>Created</dt>
                        <dd title="@Format.Timestamp(created)">@Format.Relative(created)</dd>
                    }
                    @if (item.Driver is { } driver)
                    {
                        <dt>Kept by</dt>
                        <dd class="font-mono text-xs">@driver</dd>
                    }
                    <dt>Labels</dt>
                    <dd class="font-mono text-xs">
                        @if (item.Labels.Count == 0)
                        {
                            <span class="text-secondary">None</span>
                        }
                        @foreach (var (key, value) in item.Labels.OrderBy(l => l.Key, StringComparer.Ordinal))
                        {
                            <span class="block break-all">@key=@value</span>
                        }
                    </dd>
                    <dt>ID</dt>
                    <dd class="break-all font-mono text-xs">@item.Id</dd>
                </dl>
            </section>
        </div>
    }
</div>

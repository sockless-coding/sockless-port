@page "/endpoints/{endpointId:int}/templates"
@model Sockless.Port.Web.Pages.Engine.Templates.IndexModel
@using Sockless.Port.Templates
@{
    ViewData["Title"] = "Templates";
    string PageUrl(int page) => Url.Page("/Engine/Templates/Index", new { endpointId = Model.EndpointId, q = Model.Q, category = Model.Category, source = Model.Source, p = page })!;
}

<div data-endpoint-id="@Model.EndpointId">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="page-title">Templates</h2>
            <p class="mt-1 text-secondary">
                Ready-made apps for @Model.Connection.Name. Choosing one fills in a new stack, which you check before it's deployed.
            </p>
        </div>
        <a sp-can="admin" asp-page="/TemplateSources/Index" class="btn-soft">
            <icon name="cog-6-tooth" class="h-4 w-4" /> Template sources
        </a>
    </div>

    @if (Model.Sources.Count == 1)
    {
        <div class="callout mb-4">
            <icon name="information-circle" class="h-5 w-5" />
            <p>
                These are the templates that come with Sockless Port.
                <span sp-can="admin">Add community feeds, such as Portainer's or linuxserver.io's, under <a asp-page="/TemplateSources/Index" class="text-accent underline">Template sources</a>.</span>
            </p>
        </div>
    }
    @foreach (var failing in Model.Sources.Where(s => s.Error is not null && s.TemplateCount == 0))
    {
        <div class="callout warning mb-4" role="alert">
            <icon name="exclamation-triangle" class="h-5 w-5" />
            <p>The source @failing.Name couldn't be read: @failing.Error</p>
        </div>
    }

    <form method="get" role="search" aria-label="Filter templates" class="mb-4 flex flex-wrap items-end gap-3">
        <div class="field min-w-[14rem] flex-1">
            <label for="filter-q">Search</label>
            <input id="filter-q" type="search" name="q" value="@Model.Q" placeholder="Name, description or image" autocomplete="off" />
        </div>
        <div class="field">
            <label for="filter-category">Category</label>
            <select id="filter-category" name="category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase))">@category</option>
                }
            </select>
        </div>
        @if (Model.Sources.Count > 1)
        {
            <div class="field">
                <label for="filter-source">Source</label>
                <select id="filter-source" name="source">
                    <option value="">All sources</option>
                    @foreach (var source in Model.Sources)
                    {
                        <option value="@source.Id" selected="@(source.Id == Model.Source)">@source.Name</option>
                    }
                </select>
            </div>
        }
        <button type="submit" class="btn-soft"><icon name="magnifying-glass" class="h-4 w-4" /> Filter</button>
    </form>

    @if (Model.HidesSwarm)
    {
        <p class="mb-4 text-secondary">Swarm stack templates are left out: they deploy only on a swarm manager, for swarm operators.</p>
    }

    @if (Model.Templates.Count == 0)
    {
        <section class="card">
            <div class="empty-state">
                <icon name="squares-plus" class="h-12 w-12" stroke-width="1.5" />
                <p class="text-base text-heading">@(Model.Filtered ? "No templates match" : "No templates")</p>
                <p class="text-secondary">@(Model.Filtered ? "Try other words, or another category." : "None of the sources has a template this endpoint can run.")</p>
            </div>
        </section>
    }
    else
    {
        <p class="mb-3 text-secondary" aria-live="polite">
            @Model.Total @(Model.Total == 1 ? "template" : "templates")@(Model.PageCount > 1 ? $", page {Model.PageNumber} of {Model.PageCount}" : "")
        </p>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="Templates">
            @foreach (var item in Model.Templates)
            {
                var template = item.Template;
                <li class="card flex flex-col gap-3">
                    <div class="flex items-start gap-3">
                        <partial name="_TemplateLogo" model="item" />
                        <div class="min-w-0">
                            <h3 class="font-heading text-lg leading-tight text-heading">
                                <a asp-page="/Engine/Templates/Deploy" asp-route-endpointId="@Model.EndpointId" asp-route-sourceId="@item.Source.Id" asp-route-key="@template.Key"
                                   class="hover:underline">@template.Title</a>
                            </h3>
                            <div class="mt-1 flex flex-wrap gap-1">
                                <span class="badge-stat" title="@Sockless.Port.Web.Infrastructure.TemplateDisplay.KindHint(template.Kind)">@Sockless.Port.Web.Infrastructure.TemplateDisplay.Kind(template.Kind)</span>
                                @if (Model.Sources.Count > 1)
                                {
                                    <span class="badge-stat" title="Source">@item.Source.Name</span>
                                }
                            </div>
                        </div>
                    </div>
                    <p class="line-clamp-3 text-secondary">@template.Description</p>
                    <div class="mt-auto flex flex-wrap items-center justify-between gap-2">
                        <span class="truncate font-mono text-xs text-secondary">@(template.Image ?? string.Join(", ", template.Categories))</span>
                        <a asp-page="/Engine/Templates/Deploy" asp-route-endpointId="@Model.EndpointId" asp-route-sourceId="@item.Source.Id" asp-route-key="@template.Key"
                           class="btn-soft secondary" aria-label="Use @template.Title">Use</a>
                    </div>
                </li>
            }
        </ul>

        @if (Model.PageCount > 1)
        {
            <nav aria-label="Pages" class="mt-6 flex flex-wrap items-center justify-center gap-2">
                @if (Model.PageNumber > 1)
                {
                    <a href="@PageUrl(Model.PageNumber - 1)" class="btn-soft" rel="prev">Previous</a>
                }
                <span class="text-secondary">Page @Model.PageNumber of @Model.PageCount</span>
                @if (Model.PageNumber < Model.PageCount)
                {
                    <a href="@PageUrl(Model.PageNumber + 1)" class="btn-soft" rel="next">Next</a>
                }
            </nav>
        }
    }
</div>

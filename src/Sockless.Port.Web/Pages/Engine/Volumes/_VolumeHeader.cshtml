@* Name, badges and actions of a volume, and its tabs. Model: any volume page. *@
@model Sockless.Port.Web.Infrastructure.VolumePageModel
@using Sockless.Port.Web.Pages.Engine.Volumes
@{
    var current = ViewContext.RouteData.Values["page"] as string;
    var tab = DetailModel.Tabs.FirstOrDefault(t => t.Page == current).Tab;
    var volume = Model.Volume;
    var name = VolumePageModel.ShortName(Model.VolumeName);
    var stack = Sockless.Port.Containers.ContainerLabels.Stack(volume?.Labels);
    var users = Model.UsedBy.Select(u => u.Container.Id).Distinct().Count();
}

<nav aria-label="Breadcrumb" class="mb-3 font-mono text-xs text-secondary">
    <a asp-page="/Engine/Volumes/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Volumes</a>
    <span class="text-line-accent" aria-hidden="true">/</span>
    <span aria-current="page">@name</span>
</nav>

<div class="mb-4 flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
        <h2 class="page-title break-all" title="@Model.VolumeName">@name</h2>
        @if (volume is not null)
        {
            <div class="mt-2 flex flex-wrap items-center gap-1">
                @if (volume.IsAnonymous)
                {
                    <span class="badge-stat" title="Created for a container, not by name">Anonymous</span>
                }
                <span class="badge-stat" title="Driver">@(volume.Driver ?? "unknown driver")</span>
                @if (stack is not null)
                {
                    <span class="badge-stat" title="Stack">@stack</span>
                }
                <span class="badge-stat">@(users == 0 ? "Unused" : $"Used by {users}")</span>
            </div>
        }
    </div>

    @if (volume is not null)
    {
        <div class="flex flex-wrap items-center gap-2">
            @if (tab != "files")
            {
                <form method="post" asp-page="/Engine/Volumes/Files" asp-page-handler="Open"
                      asp-route-endpointId="@Model.EndpointId" asp-route-volumeName="@Model.VolumeName">
                    <button type="submit" class="btn-soft"><icon name="folder" class="h-4 w-4" /> Browse files</button>
                </form>
            }
            <details class="menu" data-menu>
                <summary class="btn-soft" aria-label="More actions for @name">More <icon name="chevron-down" class="h-4 w-4" /></summary>
                <div class="menu-panel w-80 p-3">
                    <form method="post" asp-page="/Engine/Volumes/Detail" asp-page-handler="Remove"
                          asp-route-endpointId="@Model.EndpointId" asp-route-volumeName="@Model.VolumeName">
                        <input type="hidden" name="tab" value="@tab" />
                        <p class="label-caps mb-1">Remove</p>
                        <p class="mb-2 text-xs text-secondary">
                            @(users > 0 ? "Containers use this volume, so the engine will refuse until they're removed." : "No container uses it. Its data is deleted.")
                        </p>
                        <button type="submit" class="btn-soft danger" data-confirm="Remove volume @name? Its data is deleted and can't be recovered.">
                            <icon name="trash" class="h-4 w-4" /> Remove volume
                        </button>
                    </form>
                </div>
            </details>
        </div>
    }
</div>

<nav aria-label="Volume" class="tabs mb-6">
    @foreach (var (key, tabPage, label) in DetailModel.Tabs)
    {
        <a asp-page="@tabPage" asp-route-endpointId="@Model.EndpointId" asp-route-volumeName="@Model.VolumeName"
           class="tab" aria-current="@(key == tab ? "page" : null)">@label</a>
    }
</nav>

@if (Model.Error is not null)
{
    <div class="callout danger mb-4" role="alert">
        <icon name="exclamation-triangle" class="h-5 w-5" />
        <p>@Model.Error</p>
    </div>
}
else if (Model.Client is null)
{
    <div class="mb-4"><partial name="_EndpointStateCallout" model="Model.Connection" /></div>
}

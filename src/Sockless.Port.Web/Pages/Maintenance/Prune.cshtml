@page "/maintenance/prunes/{id:int}"
@model Sockless.Port.Web.Pages.Maintenance.PruneModel
@using Sockless.Port.Maintenance
@{
    var title = $"Prune {Model.Connection.Name}";
    ViewData["Title"] = title;
    var pageErrors = ViewData.ModelState.TryGetValue("", out var entry) ? entry.Errors.Select(e => e.ErrorMessage).ToList() : [];
}

<nav aria-label="Breadcrumb" class="mb-3 font-mono text-xs text-secondary">
    <a asp-page="/Maintenance/Index" class="hover:underline">Maintenance</a>
    <span class="text-line-accent" aria-hidden="true">/</span>
    <span aria-current="page">@title</span>
</nav>
<div class="mb-6">
    <h2 class="page-title">@title</h2>
    <p class="mt-1 max-w-3xl text-secondary">
        Removes what nothing on <span class="font-semibold">@Model.Connection.Name</span> uses, on a schedule, while it's online.
        Stopped containers count as using their images, volumes and networks. Each run is recorded in the audit log with what it removed.
    </p>
</div>

@foreach (var error in pageErrors)
{
    <div class="callout danger mb-4" role="alert">
        <icon name="exclamation-triangle" class="h-5 w-5" />
        <p>@error</p>
    </div>
}

<form method="post" class="space-y-6" novalidate asp-route-id="@Model.Connection.Id">
    <section class="card space-y-4" aria-labelledby="schedule-title">
        <h3 id="schedule-title" class="section-title">Schedule</h3>
        <div class="field max-w-xs">
            <label asp-for="IntervalHours">How often</label>
            <select asp-for="IntervalHours">
                @foreach (var hours in PruneOptions.IntervalChoices)
                {
                    <option value="@hours" selected="@(Model.IntervalHours == hours)">@(hours switch { 0 => "Off", 24 => "Every day", _ => "Every week" })</option>
                }
            </select>
            <partial name="_FieldError" model='"IntervalHours"' />
        </div>
    </section>

    <section class="card space-y-4" aria-labelledby="what-title">
        <h3 id="what-title" class="section-title">What to remove</h3>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="field">
                <label asp-for="Images">Images</label>
                <select asp-for="Images" aria-describedby="images-hint">
                    <option value="@PruneImages.None" selected="@(Model.Images == PruneImages.None)">None</option>
                    <option value="@PruneImages.Dangling" selected="@(Model.Images == PruneImages.Dangling)">Dangling (untagged leftovers)</option>
                    <option value="@PruneImages.Unused" selected="@(Model.Images == PruneImages.Unused)">Every image no container uses</option>
                </select>
                <p class="hint" id="images-hint">Images no container uses are pulled again when something needs them.</p>
                <partial name="_FieldError" model='"Images"' />
            </div>
            <div class="field">
                <label asp-for="OlderThanDays">Only images and build cache older than (days)</label>
                <input asp-for="OlderThanDays" type="number" min="0" max="@PruneOptions.MaxOlderThanDays" aria-describedby="age-hint" />
                <p class="hint" id="age-hint">0 removes them at any age. Images count from when they were created, build cache from when it was last used.</p>
                <partial name="_FieldError" model='"OlderThanDays"' />
            </div>
            <div class="field">
                <label asp-for="Volumes">Volumes</label>
                <select asp-for="Volumes" aria-describedby="volumes-hint">
                    <option value="@PruneVolumes.None" selected="@(Model.Volumes == PruneVolumes.None)">None</option>
                    <option value="@PruneVolumes.Anonymous" selected="@(Model.Volumes == PruneVolumes.Anonymous)">Unused anonymous volumes</option>
                    <option value="@PruneVolumes.All" selected="@(Model.Volumes == PruneVolumes.All)">Every unused volume, named ones too</option>
                </select>
                <p class="hint" id="volumes-hint">
                    Named volumes hold data people chose to keep; removing them loses it for good. Open file browsers are closed first.
                    @if (!Model.CanPruneAnonymousOnly)
                    {
                        <span class="block">This engine's API can't keep named volumes while pruning, so anonymous-only prunes fail on it.</span>
                    }
                </p>
                <partial name="_FieldError" model='"Volumes"' />
            </div>
            <fieldset class="space-y-2">
                <legend class="label-caps mb-1">Also</legend>
                <label class="flex items-start gap-2">
                    <input type="checkbox" name="Networks" value="true" class="mt-1 accent-accent" checked="@Model.Networks" />
                    <input type="hidden" name="Networks" value="false" />
                    <span>Unused networks <span class="block text-xs text-secondary">Networks you created that no container is attached to.</span></span>
                </label>
                <label class="flex items-start gap-2">
                    <input type="checkbox" name="BuildCache" value="true" class="mt-1 accent-accent" checked="@Model.BuildCache" />
                    <input type="hidden" name="BuildCache" value="false" />
                    <span>Build cache <span class="block text-xs text-secondary">Everything no build is using. Engines without one (Podman) skip it.</span></span>
                </label>
            </fieldset>
        </div>
    </section>

    <div class="flex justify-end gap-2">
        <a asp-page="/Maintenance/Index" class="btn-soft">Cancel</a>
        <button type="submit" class="btn-soft secondary">@(Model.IsNew ? "Schedule" : "Save")</button>
    </div>
</form>

@* Error text below a field. Model: the field id (as generated by asp-for). *@
@model string
@{
    var key = Model.Replace('_', '.');
    var errors = ViewContext.ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors : null;
}
@if (errors is { Count: > 0 })
{
    <p class="error" id="@FieldAccessibilityTagHelper.ErrorId(Model)">@errors[0].ErrorMessage</p>
}

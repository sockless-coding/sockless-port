@* One-time messages left by a form post (see Infrastructure/Flash.cs). *@
@{
    var (success, error) = Flash.Take(TempData);
}
@if (success is not null)
{
    <div class="callout success mb-4" role="status">
        <icon name="check-circle" class="h-5 w-5" />
        <p>@success</p>
    </div>
}
@if (error is not null)
{
    <div class="callout danger mb-4" role="alert">
        <icon name="exclamation-triangle" class="h-5 w-5" />
        <p>@error</p>
    </div>
}

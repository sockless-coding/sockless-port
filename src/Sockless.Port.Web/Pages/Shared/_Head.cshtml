@* Shared <head> content for every layout. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark" />
<title>@(ViewData["Title"] is string title ? $"{title} · Sockless Port" : "Sockless Port")</title>
@* htmx must not need eval or inline styles: the CSP forbids both. *@
<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0}' />
<link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
<link rel="stylesheet" href="~/css/workshop.css" />
<link rel="stylesheet" href="~/css/app.css" />
<script src="~/lib/htmx/htmx.min.js" defer></script>

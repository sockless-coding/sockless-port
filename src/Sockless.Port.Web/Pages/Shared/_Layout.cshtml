@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Sockless.Port.Engines.EngineConnections Connections
@inject Sockless.Port.Settings.PortSettings Settings
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    var topBar = TopBarView.For(Context, Connections);
    var csrfHeader = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string?>
    {
        ["RequestVerificationToken"] = Antiforgery.GetAndStoreTokens(Context).RequestToken,
    });
    var version = typeof(Program).Assembly
        .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
        .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
        .FirstOrDefault()?.InformationalVersion.Split('+')[0];

    var access = Context.Access();
    var timeDisplay = access?.TimeDisplay;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    IEnumerable<NavItem> Visible(IEnumerable<NavItem> items) =>
        items.Where(i => (i.Scope == NavScope.Global || topBar.Current is not null) && i.IsAvailable(topBar.Current?.Engine)
                         && (!i.AdminOnly || access?.IsAdmin == true)
                         && (i.Scope == NavScope.Global || access?.Can(topBar.Current!.Id, i.Needs) == true));
    object? RouteId(NavItem item) => item.Scope == NavScope.Endpoint ? topBar.Current?.Id : null;
}
<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
    <partial name="_Head" />
</head>
<body class="h-screen overflow-hidden" hx-boost="true" hx-headers="@csrfHeader">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    @* Shown while a form post or navigation is under way; driven by site.js (busy feedback). *@
    <div class="busy-bar" aria-hidden="true"></div>
    <p class="sr-only" role="status" data-busy-status></p>

    <div class="relative z-10 flex h-full">
        <aside class="flex w-64 flex-none flex-col border-r border-accent/10 bg-surface">
            <div class="flex h-16 flex-none items-center gap-3 border-b border-accent/10 px-4">
                <span class="brand-tile">
                    <partial name="_GearMark" model='"h-6 w-6"' />
                </span>
                <span class="flex flex-col leading-tight">
                    <span class="font-heading text-base font-semibold uppercase tracking-[0.1em] text-accent">Sockless</span>
                    <span class="label-caps">Port</span>
                </span>
            </div>

            <nav aria-label="Main" class="flex-1 overflow-y-auto px-3 py-4">
                <ul class="space-y-1">
                    @foreach (var item in Visible(Navigation.Main))
                    {
                        <li>
                            <a asp-page="@item.Page" asp-route-endpointId="@RouteId(item)" class="nav-item"
                               aria-current="@(Navigation.IsActive(item, currentPage) ? "page" : null)">
                                <icon name="@item.Icon" class="h-5 w-5" />
                                <span>@item.Label</span>
                            </a>
                        </li>
                    }
                </ul>
                @if (Visible(Navigation.Swarm).Any())
                {
                    <p class="label-caps mt-6 mb-2 px-3" id="nav-swarm">Swarm</p>
                    <ul class="space-y-1" aria-labelledby="nav-swarm">
                        @foreach (var item in Visible(Navigation.Swarm))
                        {
                            <li>
                                <a asp-page="@item.Page" asp-route-endpointId="@RouteId(item)" class="nav-item"
                                   aria-current="@(Navigation.IsActive(item, currentPage) ? "page" : null)">
                                    <icon name="@item.Icon" class="h-5 w-5" />
                                    <span>@item.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
                @if (Visible(Navigation.Admin).Any())
                {
                    <hr class="my-4 border-line" />
                    <ul class="space-y-1">
                        @foreach (var item in Visible(Navigation.Admin))
                        {
                            <li>
                                <a asp-page="@item.Page" asp-route-endpointId="@RouteId(item)" class="nav-item"
                                   aria-current="@(Navigation.IsActive(item, currentPage) ? "page" : null)">
                                    <icon name="@item.Icon" class="h-5 w-5" />
                                    <span>@item.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </nav>

            <div class="flex-none space-y-3 border-t border-accent/10 px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                    <a asp-page="/Account/Index" class="flex min-w-0 items-center gap-2 text-secondary hover:text-accent"
                       title="Your account: @User.Identity?.Name" aria-current="@(currentPage == "/Account/Index" ? "page" : null)">
                        <icon name="user-circle" class="h-5 w-5 flex-none" />
                        <span class="truncate">@User.Identity?.Name</span>
                    </a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn-soft">
                            <icon name="arrow-right-start-on-rectangle" class="h-4 w-4" />
                            Sign out
                        </button>
                    </form>
                </div>
                @* The time display preference; site.js submits it on change and hides the button. *@
                <form method="post" asp-page="/Account/Index" asp-page-handler="Time" class="flex items-end gap-2" data-autosubmit>
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="field flex-1">
                        <label for="time-display" class="label-caps">Times</label>
                        <select id="time-display" name="display" class="text-xs">
                            <option value="" selected="@(timeDisplay is null)">Default (@(Settings.Current.TimeDisplay == Sockless.Port.Settings.TimeDisplay.Utc ? "UTC" : "local"))</option>
                            <option value="Local" selected="@(timeDisplay == Sockless.Port.Settings.TimeDisplay.Local)">Local</option>
                            <option value="Utc" selected="@(timeDisplay == Sockless.Port.Settings.TimeDisplay.Utc)">UTC</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-soft" data-autosubmit-button>Set</button>
                </form>
                @if (version is not null)
                {
                    <p class="font-mono text-xs text-secondary">Sockless Port v@(version)</p>
                }
            </div>
        </aside>

        <div class="flex min-w-0 flex-1 flex-col">
            <header class="flex h-16 flex-none items-center justify-between gap-4 border-b border-accent/10 bg-surface px-6">
                <h1 class="truncate text-xl font-semibold">@ViewData["Title"]</h1>
                <partial name="_TopBarStatus" model="topBar" />
            </header>

            <main id="main-content" tabindex="-1" class="flex-1 overflow-y-auto p-6 focus:outline-none">
                <div class="mx-auto max-w-5xl">
                    <partial name="_Flash" />
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @* Confirms destructive actions; filled in by site.js (data-confirm / data-confirm-bulk). *@
    <dialog id="confirm-dialog" class="dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
        <form method="dialog">
            <h2 id="confirm-title" class="dialog-title">Are you sure?</h2>
            <p id="confirm-message" class="mb-6"></p>
            <div class="flex justify-end gap-2">
                <button value="cancel" class="btn-soft" autofocus>Cancel</button>
                <button value="confirm" class="btn-soft danger" data-confirm-ok>Confirm</button>
            </div>
        </form>
    </dialog>

    @* Live progress of a pull started from a page; filled in by images.js. *@
    <dialog id="job-dialog" class="dialog dialog-wide" aria-labelledby="job-dialog-title">
        <h2 id="job-dialog-title" class="dialog-title">Pulling</h2>
        <div data-job-dialog-body></div>
        <div class="mt-6 flex justify-end gap-2">
            <button type="button" class="btn-soft" data-job-dialog-background>Continue in background</button>
            <button type="button" class="btn-soft danger" data-job-dialog-cancel>Cancel pull</button>
            <button type="button" class="btn-soft" data-job-dialog-close hidden>Close</button>
        </div>
    </dialog>

    @* Libraries load once here, not per page, so boosted navigation doesn't race script loading. *@
    <script src="~/lib/signalr/signalr.min.js" defer></script>
    <script src="~/lib/chartjs/chart.umd.min.js" defer></script>
    <script src="~/lib/xterm/xterm.js" defer></script>
    <script src="~/lib/xterm/addon-fit.js" defer></script>
    <script src="~/lib/codemirror/codemirror.js" defer></script>
    <script src="~/js/site.js" defer></script>
    <script src="~/js/logs.js" defer></script>
    <script src="~/js/charts.js" defer></script>
    <script src="~/js/stats.js" defer></script>
    <script src="~/js/resources.js" defer></script>
    <script src="~/js/trends.js" defer></script>
    <script src="~/js/terminal.js" defer></script>
    <script src="~/js/images.js" defer></script>
    <script src="~/js/networks.js" defer></script>
    <script src="~/js/editor.js" defer></script>
    <script src="~/js/stacks.js" defer></script>
    <script src="~/js/git-source.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

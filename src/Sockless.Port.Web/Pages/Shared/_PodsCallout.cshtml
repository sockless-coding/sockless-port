@* Why a pod page has nothing to show: offline, an engine without pods, or a failed read. Model: any pod page. *@
@model Sockless.Port.Web.Infrastructure.PodsPageModel
@if (Model.Client is null)
{
    <div class="mb-4"><partial name="_EndpointStateCallout" model="Model.Connection" /></div>
}
else if (!Model.HasPods)
{
    <div class="callout mb-4">
        <icon name="information-circle" class="h-5 w-5" />
        <p>Pods are a Podman feature, and @Model.Connection.Name runs @(Model.Connection.Engine?.DisplayName ?? "another engine"). Its containers are under <a asp-page="/Engine/Containers/Index" asp-route-endpointId="@Model.EndpointId" class="hover:underline">Containers</a>.</p>
    </div>
}
else if (Model.Error is not null)
{
    <div class="callout danger mb-4" role="alert">
        <icon name="exclamation-triangle" class="h-5 w-5" />
        <p>@Model.Error</p>
    </div>
}

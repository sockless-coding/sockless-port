@* The stacks table: an endpoint's list, and the list across endpoints with an endpoint column. Model: StackTableView. *@
@model Sockless.Port.Web.Infrastructure.StackTableView
@using Sockless.Port.Stacks
<div class="table-wrap">
    <table class="table table-middle">
        <caption class="sr-only">Stacks</caption>
        <thead>
            <tr>
                <th scope="col">Stack</th>
                @if (Model.AcrossEndpoints)
                {
                    <th scope="col">Endpoint</th>
                }
                <th scope="col">State</th>
                <th scope="col">Services</th>
                <th scope="col">Deployed</th>
                <th scope="col" class="num"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                var deployed = row.Definition?.DeployedAt;
                var endpointName = Model.Endpoints.GetValueOrDefault(row.EndpointId) ?? "";
                var named = Model.AcrossEndpoints ? $"{row.Name} on {endpointName}" : row.Name;
                <tr>
                    <th scope="row">
                        <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <a asp-page="/Engine/Stacks/Detail" asp-route-endpointId="@row.EndpointId" asp-route-stackName="@row.Name"
                               class="break-words font-mono font-semibold hover:underline">@row.Name</a>
                            @* Compose is the usual kind: only swarm stacks say so. *@
                            @if (row.IsSwarm)
                            {
                                <span class="badge-stat" title="Deployed to the swarm with docker stack">Swarm</span>
                            }
                            @if (row.Repository is { } repository)
                            {
                                @if (repository.LastError is not null)
                                {
                                    <span class="badge danger" title="@repository.LastError">Git failing</span>
                                }
                                else
                                {
                                    <span class="badge-stat" title="From @repository.Url, branch @repository.Branch">Git</span>
                                }
                            }
                            @if (row.IsExternal)
                            {
                                var portainer = !row.IsSwarm && PortainerStacks.LooksDeployedByPortainer(row.Project);
                                <span class="badge-stat" title="@(portainer ? "Deployed by Portainer: adopting reads its files from Portainer's data" : "Deployed outside Sockless Port")">@(portainer ? "Portainer" : "External")</span>
                            }
                            @if (row.IsSelf)
                            {
                                <span class="badge-stat" title="Sockless Port runs in this stack">Sockless Port</span>
                            }
                        </span>
                    </th>
                    @if (Model.AcrossEndpoints)
                    {
                        <td class="whitespace-nowrap">
                            <a asp-page="/Engine/Stacks/Index" asp-route-endpointId="@row.EndpointId" class="inline-flex items-center gap-1 hover:text-accent hover:underline"
                               title="@(row.IsSwarm ? "Read from this swarm manager" : "Open this endpoint's stacks")">
                                <icon name="server" class="h-4 w-4 text-secondary" /> @endpointName
                            </a>
                        </td>
                    }
                    <td class="whitespace-nowrap">
                        <span class="flex items-center gap-2">
                            @if (row.Job is { IsRunning: true } job)
                            {
                                <partial name="_StatusBadge" model="StackDisplay.JobBadge(job.Status, job.Operation)" />
                            }
                            else if (row.Unknown is { } unknown)
                            {
                                <span class="text-secondary">@unknown</span>
                            }
                            else
                            {
                                <partial name="_StatusBadge" model="row.IsSwarm ? StackDisplay.State(row.Swarm) : StackDisplay.State(row.Project)" />
                            }
                            @if (row.Unhealthy > 0)
                            {
                                <a asp-page="/Engine/Containers/Index" asp-route-endpointId="@row.EndpointId" asp-route-stack="@row.Name" asp-route-state="unhealthy"
                                   class="badge danger hover:underline">@row.Unhealthy unhealthy</a>
                            }
                            @if (row.Updates > 0)
                            {
                                var what = row.IsSwarm ? (row.Updates == 1 ? "service" : "services") : (row.Updates == 1 ? "container" : "containers");
                                <span class="badge warning" title="The registry has a newer image for @row.Updates @what">Update available</span>
                                <span class="sr-only">for @row.Updates @what</span>
                            }
                        </span>
                    </td>
                    <td class="max-w-[20rem]">
                        @if (row.ServiceNames.Count == 0)
                        {
                            <span class="text-secondary">—</span>
                        }
                        else
                        {
                            <span class="block truncate font-mono text-xs" title="@string.Join(", ", row.ServiceNames)">@string.Join(", ", row.ServiceNames)</span>
                        }
                    </td>
                    <td class="whitespace-nowrap text-secondary">
                        @if (row.IsExternal)
                        {
                            <span>Not from here</span>
                        }
                        else if (deployed is { } at)
                        {
                            <span title="@Format.Timestamp(at)">@Format.Relative(at)</span>
                        }
                        else
                        {
                            <span>Never</span>
                        }
                    </td>
                    <td class="num">
                        @if (row.CanEdit && row.IsExternal && !row.IsSwarm && !row.IsSelf)
                        {
                            <a asp-page="/Engine/Stacks/Create" asp-route-endpointId="@row.EndpointId" asp-route-adopt="@row.Name" class="btn-soft"
                               aria-label="Adopt @named" title="Take it over: Sockless Port keeps its files and deploys it from now on">
                                <icon name="arrow-down-on-square" class="h-4 w-4" /> Adopt
                            </a>
                        }
                        else if (row.CanEdit && !row.IsExternal)
                        {
                            <a asp-page="/Engine/Stacks/Editor" asp-route-endpointId="@row.EndpointId" asp-route-stackName="@row.Name"
                               class="btn-soft btn-icon" aria-label="Edit @named" title="Edit">
                                <icon name="pencil-square" class="h-4 w-4" />
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

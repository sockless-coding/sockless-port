<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Sockless.Port.Web</RootNamespace>
    <AssemblyName>Sockless.Port.Web</AssemblyName>
    <UserSecretsId>sockless-port-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sockless.Port.Core\Sockless.Port.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Heroicons (outline), rendered inline by IconTagHelper. -->
    <EmbeddedResource Include="Icons\*.svg" LogicalName="Icons.%(Filename).svg" />
    <!-- Tailwind sources, not served. -->
    <Content Remove="Styles\**" />
    <None Include="Styles\**" />
    <Content Remove="tailwind.config.js" />
    <None Include="tailwind.config.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sockless.Port.Web.Tests" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build\Tailwind.targets" />
</Project>
